---
// Non-Hero implementation of CLAUDE.md's "Ambient glow recipe" / "Monumental-mark-
// watermark recipe" - the same two ingredients that make Home's Hero feel lit and
// premium, reused wherever another page's own intro needs the same treatment (first
// consumer: /approach; /work has the same plain-intro shape and is a near-certain
// second). Hero itself stays untouched - its version is entangled with boot-sequence
// timing and isn't worth disturbing to share code with a much simpler case.
//
// Purely decorative and content-agnostic: renders a glow + a bleeding-corner PixelMark
// behind whatever is slotted in, and has no opinion on that content's own layout.
import PixelMark from './PixelMark.astro';

interface Props {
  markSize?: number;
}

const { markSize = 512 } = Astro.props;
---

<div class="intro-atmosphere">
  <div class="intro-atmosphere-mark" aria-hidden="true">
    <PixelMark size={markSize} decorative />
  </div>
  <div class="intro-atmosphere-content">
    <slot />
  </div>
</div>

<style>
  /* min-height + vertical centering, not a thin top banner: full-redesign-pass
     finding - even with matching type/glow, a ~350px band read as a fundamentally
     smaller "moment" than Hero's near-full-viewport height, which is a big part of
     why the two pages didn't feel like the same design at a glance. This isn't
     Hero's full height (this page still has four sections below it, unlike Home),
     but it's a real, deliberate arrival space now rather than a compressed strip. */
  .intro-atmosphere {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 60vh;
    padding: var(--space-8) 0;
  }

  /* Same two-blob recipe as Hero's ambient glow. At this larger scale the
     container's aspect ratio is close enough to Hero's own that its ellipse
     proportions carry over directly instead of needing the flattened-box
     compensation the previous, much shorter version required. */
  .intro-atmosphere::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(
        30% 44% at 30% 40%,
        color-mix(in srgb, var(--accent-primary) 16%, transparent),
        transparent 100%
      ),
      radial-gradient(
        24% 36% at 74% 70%,
        color-mix(in srgb, var(--accent-status) 10%, transparent),
        transparent 100%
      );
  }

  /* Light mode needs a materially bolder primary blob, not just a brightness shift -
     the same Weber-Fechner lesson from Hero's glow (a percentage shift that reads as
     an obvious glow near black is nearly imperceptible near white). Coral/accent-status
     is dropped here too (it saturates too visibly against Paper); --text at low opacity
     stands in as the second "shadow" point of depth, same substitution Hero's own
     light-mode override already makes. */
  :global(html[data-theme='light']) .intro-atmosphere::before {
    background:
      radial-gradient(
        34% 50% at 28% 48%,
        color-mix(in srgb, var(--accent-primary) 25%, transparent),
        transparent 100%
      ),
      radial-gradient(
        28% 42% at 76% 76%,
        color-mix(in srgb, var(--text) 6%, transparent),
        transparent 100%
      );
  }

  /* Monumental-mark-watermark recipe, now scaled much closer to Hero's own 34rem -
     the container is real Hero-like scale now, so the mark reads at a matching
     scale too rather than looking lost in the larger space. overflow:hidden on the
     parent makes bleeding into the header above or the content below structurally
     impossible, not just positionally unlikely - same guarantee Hero's .hero
     relies on. */
  .intro-atmosphere-mark {
    position: absolute;
    z-index: 0;
    bottom: -6vh;
    right: -7rem;
    opacity: 0.07;
    pointer-events: none;
  }

  .intro-atmosphere-mark :global(svg) {
    display: block;
    width: 28rem;
    height: auto;
  }

  @media (max-width: 40rem) {
    .intro-atmosphere-mark :global(svg) {
      width: 16rem;
    }
  }

  /* Ink outline at low opacity over Paper reads as a faint gray smudge rather than a
     recognizable shape at the same alpha that works for Signal green over Ink - same
     per-mode lesson as Hero's mark, re-verified at this smaller render size rather than
     assumed to carry over. */
  :global(html[data-theme='light']) .intro-atmosphere-mark {
    opacity: 0.05;
  }

  /* .intro-atmosphere itself is full-bleed (no width constraint) so the glow/mark
     reach the actual viewport edges, matching Hero's own .hero/.bezel split - only
     the CONTENT gets the same width: min(100% - 2*space-4, content-max-width)
     column every other /approach section already uses, so the headline's left edge
     lines up with everything below it. */
  .intro-atmosphere-content {
    position: relative;
    z-index: 1;
    width: min(100% - 2 * var(--space-4), var(--content-max-width));
    margin: 0 auto;
  }
</style>
