---
// Name, email, company, message. Submits via Netlify Forms (static HTML scan requires
// data-netlify="true" + matching name + hidden form-name input, present verbatim in
// the built output). Plain mailto fallback rendered near the form, not styled as a
// competing CTA (SPEC.md — ContactForm). Delivery address is a temporary placeholder,
// flagged in SPEC.md — replace before public launch.
---

<form name="contact" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" class="contact-form">
  <input type="hidden" name="form-name" value="contact" />
  <p class="honeypot" aria-hidden="true">
    <label>
      Leave this field blank
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <label>
    <span>Name</span>
    <input class="pixel-notch" type="text" name="name" required />
  </label>

  <label>
    <span>Email</span>
    <input class="pixel-notch" type="email" name="email" required />
  </label>

  <label>
    <span>Company</span>
    <input class="pixel-notch" type="text" name="company" />
  </label>

  <label>
    <span>Message</span>
    <textarea class="pixel-notch" name="message" rows="6" required></textarea>
  </label>

  <button class="pixel-notch" type="submit">Send</button>
</form>

<p class="mailto-fallback">
  Prefer email? Write to <a href="mailto:hoda.97@live.com">hoda.97@live.com</a> directly.
</p>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 32rem;
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  input,
  textarea {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 1rem;
  }

  /* clip-path (.pixel-notch) cuts two corners off each field, so an outward `outline`/
     `box-shadow` would get clipped away right where it's cut. An inset ring stays
     inside the clipped shape instead. */
  input:focus-visible,
  textarea:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--accent-primary);
  }

  textarea {
    resize: vertical;
  }

  button[type='submit'] {
    align-self: flex-start;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--accent-primary);
    border-radius: var(--radius);
    background: var(--accent-primary);
    color: var(--on-accent-primary);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }

  button[type='submit']:hover,
  button[type='submit']:focus-visible {
    opacity: 0.85;
  }

  /* Same clip-path corner issue as inputs above — inset ring instead of outline. */
  button[type='submit']:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--on-accent-primary);
  }

  .mailto-fallback {
    margin-top: var(--space-6);
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }
</style>
