---
// Small heading + CTAButton band, reused on / and /about (SPEC.md — Pages & routes).
// Copy is the approved tagline, verbatim, from BRANDFINAL.md — Tagline.
import CTAButton from './CTAButton.astro';
---

<section class="contact-cta">
  <p>I turn fragmented data into systems you can actually trust.</p>
  <CTAButton />
</section>

<style>
  .contact-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-16) var(--space-4);
    text-align: center;
  }

  .contact-cta p {
    max-width: 32rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.125rem;
  }
</style>
