---
// Mark, tagline headline, one-line outcome-framed subhead, CTA — wrapped in the CRT/
// boot-sequence bezel with terminal-prompt flourish (typewriter reveal, blinking caret,
// $ whoami-style lines) and a pixel-art retro mouse cursor on hover. SPEC.md is explicit:
// Hero is the ONLY component allowed to use these motion/CRT effects — don't reuse the
// bezel, caret-blink, or typewriter animation elsewhere.
//
// Headline is the approved tagline verbatim (BRANDFINAL.md — Tagline). Subhead is
// outcome-framed per BRANDFINAL §2 ("lead with what the client gets, not the AI
// label"), grounded in §5's "Clarity is engineered, not promised" pillar — full
// lifecycle discipline is what makes any AI layer trustworthy — no new claims invented.
import PixelMark from './PixelMark.astro';
import CTAButton from './CTAButton.astro';

// Hand-authored pixel-art retro cursor (classic chunky arrow, white backing for
// visibility on both Ink and Paper) — round-1 feedback asked for "old-fashioned mouse
// icon" styling. Built the same way as PixelMark: a coordinate list rendered to rects.
const cursorPixels: Array<[number, number]> = [
  [0, 0],
  [0, 1], [1, 1],
  [0, 2], [1, 2], [2, 2],
  [0, 3], [1, 3], [2, 3], [3, 3],
  [0, 4], [1, 4], [2, 4], [3, 4], [4, 4],
  [0, 5], [1, 5], [2, 5],
  [0, 6], [2, 6],
  [3, 7],
];
const cursorRects = cursorPixels
  .map(([x, y]) => `<rect x='${x}' y='${y}' width='1' height='1' fill='black'/>`)
  .join('');
const cursorSvg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='-1 -1 8 10' shape-rendering='crispEdges'><rect x='-1' y='-1' width='8' height='10' fill='white' fill-opacity='0.85'/>${cursorRects}</svg>`;
const cursorCss = `url("data:image/svg+xml,${encodeURIComponent(cursorSvg)}") 0 0, auto`;
---

<section class="hero" style={{ '--pixel-cursor': cursorCss }}>
  <div class="bezel">
    <span class="rivet corner-tl" aria-hidden="true"></span>
    <span class="rivet corner-tr" aria-hidden="true"></span>
    <span class="rivet corner-bl" aria-hidden="true"></span>
    <span class="rivet corner-br" aria-hidden="true"></span>

    <div class="bezel-chrome">
      <span class="led" aria-hidden="true"></span>
      <span class="bezel-label">xheia_terminal</span>
      <span class="chrome-buttons" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </div>

    <div class="screen">
      <div class="scanlines" aria-hidden="true"></div>

      <p class="prompt-line">
        <span class="prompt-glyph">$</span> <span class="typed typed-1">whoami</span>
      </p>
      <p class="prompt-line prompt-response">
        <span class="prompt-glyph">&gt;</span> <span class="typed typed-2"
          >full-stack data consultant</span
        ><span class="caret" aria-hidden="true"></span>
      </p>

      <div class="brand-row">
        <PixelMark size={40} />
        <span class="wordmark">xheia</span>
      </div>

      <h1 class="headline">I turn fragmented data into systems you can actually trust.</h1>

      <p class="subhead">
        Full-lifecycle data work — cleansing, migration, warehousing, BI — so any AI you
        build on top actually holds up.
      </p>

      <CTAButton class="hero-cta" />
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    justify-content: center;
    padding: var(--space-8) var(--space-4);
  }

  .bezel {
    position: relative;
    width: 100%;
    max-width: var(--content-max-width);
    border: 3px solid var(--border);
    background: var(--bg);
    box-shadow: inset 0 0 3rem color-mix(in srgb, var(--text) 8%, transparent);
  }

  .rivet {
    position: absolute;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--border);
  }

  .corner-tl {
    top: 0.4rem;
    left: 0.4rem;
  }

  .corner-tr {
    top: 0.4rem;
    right: 0.4rem;
  }

  .corner-bl {
    bottom: 0.4rem;
    left: 0.4rem;
  }

  .corner-br {
    bottom: 0.4rem;
    right: 0.4rem;
  }

  .bezel-chrome {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .led {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent-status);
  }

  .chrome-buttons {
    display: inline-flex;
    gap: 0.25rem;
    margin-left: auto;
  }

  .chrome-buttons span {
    width: 0.4rem;
    height: 0.4rem;
    border: 1px solid var(--border);
  }

  .screen {
    position: relative;
    overflow: hidden;
    padding: var(--space-12) var(--space-6);
    text-align: center;
    cursor: var(--pixel-cursor);
  }

  .scanlines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 3px,
      color-mix(in srgb, var(--text) 4%, transparent) 4px
    );
  }

  .prompt-line {
    position: relative;
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-align: left;
    max-width: 24rem;
    margin-inline: auto;
    white-space: nowrap;
  }

  .prompt-response {
    color: var(--text-secondary);
  }

  .prompt-glyph {
    color: var(--accent-primary);
  }

  .typed {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    width: 0;
    animation-timing-function: steps(30, end);
    animation-fill-mode: forwards;
  }

  .typed-1 {
    width: 6ch;
    animation-name: type-reveal;
    animation-duration: 0.4s;
  }

  .typed-2 {
    width: 27ch;
    animation-name: type-reveal;
    animation-duration: 1s;
    animation-delay: 0.5s;
  }

  @keyframes type-reveal {
    from {
      width: 0;
    }
  }

  .caret {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.25em;
    background: var(--accent-status);
    vertical-align: text-bottom;
    opacity: 0;
    animation:
      caret-appear 0s forwards 1.5s,
      caret-blink 1s steps(1) infinite 1.5s;
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
      opacity: 1;
    }

    .typed {
      width: auto !important;
      animation: none;
    }
  }

  @keyframes caret-appear {
    to {
      opacity: 1;
    }
  }

  @keyframes caret-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .brand-row {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-8) 0 var(--space-6);
  }

  .brand-row .wordmark {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 500;
  }

  .headline {
    position: relative;
    max-width: 40rem;
    margin: 0 auto var(--space-6);
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.4vw + 0.5rem, 1.75rem);
    line-height: 1.6;
    white-space: normal;
  }

  .subhead {
    position: relative;
    max-width: 32rem;
    margin: 0 auto var(--space-8);
    color: var(--text-secondary);
    font-size: 1.0625rem;
    white-space: normal;
  }
</style>
