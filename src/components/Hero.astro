---
// Mark, tagline headline, one-line outcome-framed subhead, CTA — wrapped in the CRT/
// boot-sequence bezel. Home is now Hero-only (see SPEC.md's structural-redesign
// revision note), so this fills most of the viewport and carries a much richer boot
// sequence than before: a fast module-loading preamble, the signature typed $ whoami
// exchange, then an operator--info line folding in what used to be a separate
// IdentityHook component below the Hero. SPEC.md is explicit: this literal boot-sequence
// device (typed terminal lines, chrome-buttons bar) stays Hero-exclusive — the broader
// pixel-art system (rivets, cursor, scanlines) extends site-wide, see BRANDFINAL.md.
//
// Headline is the approved tagline verbatim (BRANDFINAL.md — Tagline). Subhead is
// outcome-framed per BRANDFINAL §2 ("lead with what the client gets, not the AI
// label"), grounded in §5's "Clarity is engineered, not promised" pillar. Module names
// in the boot preamble are the existing Capabilities categories staged as a boot
// flourish, not new claims. Operator line matches the real-content pass's revised
// origin story (BRANDFINAL.md §1) — same fact as /about's opening line.
//
// Layout: the boot log sits in its own contained sub-panel with a dashed divider before
// the brand-row/headline content, rather than floating loose in the screen's padding —
// fixes the "boot log on top, then massive writing underneath" seam that read as two
// unrelated things stacked, not one composition.
import PixelMark from './PixelMark.astro';
import PixelRivets from './PixelRivets.astro';
import CTAButton from './CTAButton.astro';

// Sequential boot-log timing, computed once rather than hand-tuned per line — a running
// clock that each phase advances, so reordering/adding lines doesn't require re-deriving
// every delay by hand.
let clock = 0;
const next = (duration: number) => {
  const delay = clock;
  clock += duration;
  return delay;
};

const preamble = ['$ xheia --init', '> loading modules...'].map((text) => ({
  text,
  delay: next(0.2),
}));

const modules = ['cleansing.sys', 'warehousing.sys', 'agentic_ai.sys'].map((name) => {
  const delay = next(0.4);
  return { name, delay, barDelay: delay + 0.05 };
});

const postamble = ['> system ready'].map((text) => ({ text, delay: next(0.3) }));

const typedWhoamiDelay = clock + 0.2;
const typedRoleDelay = typedWhoamiDelay + 0.4 + 0.3;
const roleTypedDuration = 1;

const operatorCommandDelay = typedRoleDelay + roleTypedDuration + 0.3;
const operatorResponseDelay = operatorCommandDelay + 0.25;
const finalCaretDelay = operatorResponseDelay + 0.3;
---

<section class="hero">
  <div class="bezel">
    <PixelRivets />

    <div class="bezel-chrome">
      <span class="led" aria-hidden="true"></span>
      <span class="bezel-label">xheia_terminal</span>
      <span class="chrome-buttons" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </div>

    <div class="screen">
      <div class="scanlines" aria-hidden="true"></div>

      <div class="boot-log">
        {
          preamble.map((line) => (
            <p class="boot-line" style={{ animationDelay: `${line.delay}s` }}>
              {line.text}
            </p>
          ))
        }
        {
          modules.map((mod) => (
            <p class="boot-line module-line" style={{ animationDelay: `${mod.delay}s` }}>
              <span class="module-name">{mod.name}</span>
              <span class="progress-bar" aria-hidden="true">
                <span class="progress-fill" style={{ animationDelay: `${mod.barDelay}s` }} />
              </span>
              <span class="module-status" style={{ animationDelay: `${mod.barDelay + 0.35}s` }}>
                OK
              </span>
            </p>
          ))
        }
        {
          postamble.map((line) => (
            <p class="boot-line" style={{ animationDelay: `${line.delay}s` }}>
              {line.text}
            </p>
          ))
        }

        <p class="prompt-line">
          <span class="prompt-glyph">$</span>{' '}
          <span class="typed typed-1" style={{ animationDelay: `${typedWhoamiDelay}s` }}>
            whoami
          </span>
        </p>
        <p class="prompt-line prompt-response">
          <span class="prompt-glyph">&gt;</span>{' '}
          <span class="typed typed-2" style={{ animationDelay: `${typedRoleDelay}s` }}
            >full-stack data consultant</span
          >
        </p>

        <p class="boot-line" style={{ animationDelay: `${operatorCommandDelay}s` }}>
          $ operator --info
        </p>
        <p
          class="boot-line prompt-response operator-line"
          style={{ animationDelay: `${operatorResponseDelay}s` }}
        >
          &gt; Hoda — four-plus years contracting across the UK, not one specialism. (<a
            href="/about">more</a
          >)<span class="caret" style={{ animationDelay: `${finalCaretDelay}s` }} aria-hidden="true"
          ></span>
        </p>
      </div>

      <div class="zone-divider" aria-hidden="true"></div>

      <div class="brand-row">
        <PixelMark size={40} />
        <span class="wordmark">xheia</span>
      </div>

      <h1 class="headline">I turn fragmented data into systems you can actually trust.</h1>

      <p class="subhead">
        Full-lifecycle data work — cleansing, migration, warehousing, BI — so any AI you
        build on top actually holds up.
      </p>

      <CTAButton class="hero-cta" />
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: calc(100vh - 5rem);
    padding: var(--space-8) var(--space-4);
  }

  .bezel {
    position: relative;
    width: 100%;
    max-width: var(--content-max-width);
    border: 3px solid var(--border);
    background: var(--bg);
    box-shadow: inset 0 0 3rem color-mix(in srgb, var(--text) 8%, transparent);
  }

  .bezel-chrome {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .led {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent-status);
  }

  .chrome-buttons {
    display: inline-flex;
    gap: 0.25rem;
    margin-left: auto;
  }

  .chrome-buttons span {
    width: 0.4rem;
    height: 0.4rem;
    border: 1px solid var(--border);
  }

  .screen {
    position: relative;
    overflow: hidden;
    padding: var(--space-12) var(--space-6);
    text-align: center;
  }

  .scanlines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 3px,
      color-mix(in srgb, var(--text) 4%, transparent) 4px
    );
  }

  .boot-log {
    max-width: 26rem;
    margin: 0 auto;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--text) 4%, transparent);
    text-align: left;
  }

  .zone-divider {
    max-width: 26rem;
    height: 0;
    margin: var(--space-6) auto;
    border-top: 2px dashed var(--border);
  }

  .boot-line,
  .prompt-line {
    position: relative;
    margin: 0 0 var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    white-space: nowrap;
    opacity: 0;
    animation: boot-line-in 0.01s steps(1) forwards;
  }

  @keyframes boot-line-in {
    to {
      opacity: 1;
    }
  }

  .module-line {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-left: 1.5em;
    color: var(--text-secondary);
  }

  .module-name {
    min-width: 8ch;
  }

  .progress-bar {
    display: inline-flex;
    width: 5rem;
    height: 0.5rem;
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .progress-fill {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent-status);
    animation: progress-fill-in 0.35s steps(8, end) forwards;
  }

  @keyframes progress-fill-in {
    to {
      width: 100%;
    }
  }

  .module-status {
    color: var(--accent-status);
    opacity: 0;
    animation: boot-line-in 0.01s steps(1) forwards;
  }

  .prompt-response {
    color: var(--text-secondary);
  }

  .operator-line {
    white-space: normal;
  }

  .prompt-glyph {
    color: var(--accent-primary);
  }

  .typed {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    width: 0;
    animation-timing-function: steps(30, end);
    animation-fill-mode: forwards;
  }

  .typed-1 {
    width: 6ch;
    animation-name: type-reveal;
    animation-duration: 0.4s;
  }

  .typed-2 {
    width: 27ch;
    animation-name: type-reveal;
    animation-duration: 1s;
  }

  @keyframes type-reveal {
    from {
      width: 0;
    }
  }

  .caret {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.25em;
    background: var(--accent-status);
    vertical-align: text-bottom;
    opacity: 0;
    animation:
      caret-appear 0s forwards,
      caret-blink 1s steps(1) infinite;
    /* animation-delay set inline per-instance (see markup) — overrides any value here. */
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
      opacity: 1;
    }

    .typed {
      width: auto !important;
      animation: none;
    }

    .boot-line,
    .module-status {
      opacity: 1;
      animation: none;
    }

    .progress-fill {
      width: 100%;
      animation: none;
    }
  }

  @keyframes caret-appear {
    to {
      opacity: 1;
    }
  }

  @keyframes caret-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .brand-row {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-6);
  }

  .brand-row .wordmark {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 500;
  }

  .headline {
    position: relative;
    max-width: 40rem;
    margin: 0 auto var(--space-6);
    font-family: var(--font-display);
    font-size: clamp(1rem, 2vw + 0.5rem, 1.5rem);
    line-height: 1.6;
    white-space: normal;
  }

  .subhead {
    position: relative;
    max-width: 32rem;
    margin: 0 auto var(--space-8);
    color: var(--text-secondary);
    font-size: 1.0625rem;
    white-space: normal;
  }
</style>
