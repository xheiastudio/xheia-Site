---
// Mark, tagline headline, one-line outcome-framed subhead, CTA — wrapped in the CRT/
// boot-sequence bezel. Home is now Hero-only (see SPEC.md's structural-redesign
// revision note), so this fills most of the viewport and carries a much richer boot
// sequence than before: a fast module-loading preamble, the signature typed $ whoami
// exchange, then an operator--info line folding in what used to be a separate
// IdentityHook component below the Hero. SPEC.md is explicit: this literal boot-sequence
// device (typed terminal lines, chrome-buttons bar) stays Hero-exclusive — the broader
// pixel-art system (rivets, cursor, scanlines) extends site-wide, see BRANDFINAL.md.
//
// Headline is the approved tagline verbatim (BRANDFINAL.md — Tagline). Subhead is
// outcome-framed per BRANDFINAL §2 ("lead with what the client gets, not the AI
// label"), grounded in §5's "Clarity is engineered, not promised" pillar. Module names
// in the boot preamble are the existing Capabilities categories staged as a boot
// flourish, not new claims. Operator line matches the real-content pass's revised
// origin story (BRANDFINAL.md §1) — same fact as /about's opening line.
//
// Single-frame terminal pass: everything (boot log, headline, subhead, CTA) lives inside
// ONE left-aligned `.terminal-body`, not a separately bordered/tinted box nested inside
// the outer CRT bezel — the previous layout had a "terminal within a terminal" look. The
// headline/subhead are the terminal's own biggest lines of output, in the same mono font
// and `>`/`//` prompt conventions as everything above them (BRANDFINAL.md's type-system
// note updated: the pixel font's Hero-headline use no longer applies to Home). No
// brand-row here — Header already shows the mark+wordmark on every page including Home.
// The bezel now stretches to fill the available viewport height/width (not capped to
// `--content-max-width`) — live feedback was that the terminal read as small/oddly
// proportioned relative to the page.
//
// Looping boot log, static tagline: the boot log (preamble through the operator-info
// exchange) loops indefinitely — it's ambient "the system is alive" decoration, not a
// one-shot narrative gate. It lives in its own `#boot-loop` container; a small script
// re-inserts that container's own markup on an interval (`container.innerHTML =
// container.innerHTML`), which is the simplest reliable way to restart every child's
// CSS animation-delay from zero without hand-toggling each one individually. The
// headline/subhead/CTA are NOT part of that loop and are NOT gated behind any reveal —
// they're plain, always-visible content, so there's no scenario where they "disappear"
// on a revisit (the earlier `boot-skip`/sessionStorage mechanism existed only to paper
// over that; it's gone now because there's nothing left to skip).
//
// Typing: every single-line item (preamble/postamble/whoami/role/operator command,
// module names) types out character-by-character via the width-clip `.typed` technique.
// The operator-response line does NOT — it wraps onto multiple lines, and animating a
// fixed inline-block's width while its content wraps causes the browser to re-wrap the
// partially-revealed text at every animation step, throwing line breaks around
// chaotically (this broke the operator-response line in an earlier pass — see git
// history). It uses `.line-reveal` instead: a plain delayed opacity reveal. Keep new
// multi-line content inside the loop on `.line-reveal`, not `.typed` — standing rule.
import PixelRivets from './PixelRivets.astro';
import CTAButton from './CTAButton.astro';

const CPS = 70; // characters typed per second — fast but still visibly "typed"
const DWELL = 0.1; // pause after a line finishes before the next one starts
const BEAT = 0.25; // longer pause marking a new "section" of the session
const BAR_FILL_DURATION = 0.35;
const HOLD = 2; // how long the fully-booted log stays put before the loop resets

let clock = 0;

const typeLine = (glyph: '$' | '>', text: string) => {
  const delay = clock;
  const duration = text.length / CPS;
  clock = delay + duration + DWELL;
  return { glyph, text, delay, duration };
};

// A full character of slack so font-metric rounding can't clip the last glyph — the
// reveal still reads as "typed to completion," just with breathing room at the edge.
const padWidth = (charCount: number) => `${charCount + 1}ch`;

// Same delay+duration budget as typeLine(), for the one line that reveals as a block
// instead of typing character-by-character (see the wrapping note above).
const blockLine = (text: string) => {
  const delay = clock;
  const duration = text.length / CPS;
  clock = delay + duration + DWELL;
  return { delay, duration };
};

const preamble = [typeLine('$', 'xheia --init'), typeLine('>', 'loading modules...')];

const modules = ['cleansing.sys', 'warehousing.sys', 'agentic_ai.sys'].map((name) => {
  const delay = clock;
  const duration = name.length / CPS;
  const barDelay = delay + duration + 0.05;
  const statusDelay = barDelay + BAR_FILL_DURATION + 0.1;
  clock = statusDelay + DWELL;
  return { name, delay, duration, barDelay, statusDelay };
});

const postamble = [typeLine('>', 'system ready')];

clock += BEAT;
const whoami = typeLine('$', 'whoami');
const role = typeLine('>', 'full-stack data consultant');

clock += BEAT;
const operatorCommand = typeLine('$', 'operator --info');
const operatorResponseText =
  'Hoda — four-plus years contracting across the UK, not one specialism. (more)';
const operatorResponse = blockLine(operatorResponseText);
const finalCaretDelay = operatorResponse.delay + operatorResponse.duration + 0.1;

const loopDuration = finalCaretDelay + HOLD;
const loopDurationMs = Math.ceil(loopDuration * 1000);

const headlineText = 'I turn fragmented data into systems you can actually trust.';
const subheadText =
  'Full-lifecycle data work — cleansing, migration, warehousing, BI — so any AI you build on top actually holds up.';
---

<section class="hero">
  <div class="bezel">
    <PixelRivets />

    <div class="bezel-chrome">
      <span class="led" aria-hidden="true"></span>
      <span class="bezel-label">xheia_terminal</span>
      <span class="chrome-buttons" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </div>

    <div class="screen">
      <div class="scanlines" aria-hidden="true"></div>

      <div class="terminal-body">
        <div id="boot-loop" class="boot-loop">
          {
            preamble.map((line) => (
              <p class="boot-line">
                <span class="prompt-glyph">{line.glyph}</span>{' '}
                <span
                  class="typed"
                  style={{
                    width: padWidth(line.text.length),
                    animationDuration: `${line.duration}s`,
                    animationDelay: `${line.delay}s`,
                    animationTimingFunction: `steps(${line.text.length}, end)`,
                  }}
                >
                  {line.text}
                </span>
              </p>
            ))
          }
          {
            modules.map((mod) => (
              <p class="boot-line module-line">
                <span class="module-name">
                  <span
                    class="typed"
                    style={{
                      width: padWidth(mod.name.length),
                      animationDuration: `${mod.duration}s`,
                      animationDelay: `${mod.delay}s`,
                      animationTimingFunction: `steps(${mod.name.length}, end)`,
                    }}
                  >
                    {mod.name}
                  </span>
                </span>
                <span class="progress-bar" aria-hidden="true">
                  <span class="progress-fill" style={{ animationDelay: `${mod.barDelay}s` }} />
                </span>
                <span class="module-status" style={{ animationDelay: `${mod.statusDelay}s` }}>
                  OK
                </span>
              </p>
            ))
          }
          {
            postamble.map((line) => (
              <p class="boot-line">
                <span class="prompt-glyph">{line.glyph}</span>{' '}
                <span
                  class="typed"
                  style={{
                    width: padWidth(line.text.length),
                    animationDuration: `${line.duration}s`,
                    animationDelay: `${line.delay}s`,
                    animationTimingFunction: `steps(${line.text.length}, end)`,
                  }}
                >
                  {line.text}
                </span>
              </p>
            ))
          }

          <p class="boot-line">
            <span class="prompt-glyph">{whoami.glyph}</span>{' '}
            <span
              class="typed"
              style={{
                width: padWidth(whoami.text.length),
                animationDuration: `${whoami.duration}s`,
                animationDelay: `${whoami.delay}s`,
                animationTimingFunction: `steps(${whoami.text.length}, end)`,
              }}
            >
              {whoami.text}
            </span>
          </p>
          <p class="boot-line prompt-response">
            <span class="prompt-glyph">{role.glyph}</span>{' '}
            <span
              class="typed"
              style={{
                width: padWidth(role.text.length),
                animationDuration: `${role.duration}s`,
                animationDelay: `${role.delay}s`,
                animationTimingFunction: `steps(${role.text.length}, end)`,
              }}
            >
              {role.text}
            </span>
          </p>

          <p class="boot-line">
            <span class="prompt-glyph">{operatorCommand.glyph}</span>{' '}
            <span
              class="typed"
              style={{
                width: padWidth(operatorCommand.text.length),
                animationDuration: `${operatorCommand.duration}s`,
                animationDelay: `${operatorCommand.delay}s`,
                animationTimingFunction: `steps(${operatorCommand.text.length}, end)`,
              }}
            >
              {operatorCommand.text}
            </span>
          </p>
          <p
            class="boot-line prompt-response operator-line line-reveal"
            style={{ animationDelay: `${operatorResponse.delay + operatorResponse.duration}s` }}
          >
            <span class="prompt-glyph">&gt;</span>{' '}
            Hoda — four-plus years contracting across the UK, not one specialism. (<a
              href="/about">more</a
            >)<span
              class="caret"
              style={{ animationDelay: `${finalCaretDelay}s` }}
              aria-hidden="true"
            ></span>
          </p>
        </div>

        <h1 class="headline">
          <span class="prompt-glyph" aria-hidden="true">&gt;</span> {headlineText}
        </h1>

        <p class="subhead">
          <span class="comment-glyph" aria-hidden="true">//</span> {subheadText}
        </p>

        <div class="cta-wrap">
          <CTAButton class="hero-cta" />
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ loopDurationMs }}>
  // Restarts the boot log's animations by re-inserting its own markup — the simplest
  // reliable way to reset every child's animation-delay to zero without individually
  // toggling `animation: none` + reflow on each of the ~15 separately-animated spans.
  // Skips a given cycle if focus is currently inside the loop (its only focusable
  // element is the "more" link) — rebuilding the DOM would silently drop focus to
  // <body> mid-navigation for a keyboard/screen-reader user; the loop just tries again
  // next interval instead of forcing a reset through.
  //
  // The addEventListener call itself is guarded (`__xheiaLoopBound`) since `is:inline`
  // re-executes this block on every soft navigation that lands on Home — without the
  // guard, each revisit would stack another permanent `astro:page-load` listener (same
  // guard pattern as PixelCursor.astro). The interval clear+recreate logic still runs
  // on every page-load *inside* that one listener, so revisits correctly get a fresh
  // interval targeting the newly-swapped-in `#boot-loop` element.
  if (!window.__xheiaLoopBound) {
    window.__xheiaLoopBound = true;
    document.addEventListener('astro:page-load', () => {
      if (window.__xheiaLoopInterval) {
        clearInterval(window.__xheiaLoopInterval);
        window.__xheiaLoopInterval = null;
      }

      const loop = document.getElementById('boot-loop');
      if (!loop) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      window.__xheiaLoopInterval = setInterval(() => {
        if (loop.contains(document.activeElement)) return;
        loop.innerHTML = loop.innerHTML;
      }, loopDurationMs);
    });
  }
</script>

<style>
  .hero {
    display: flex;
    justify-content: center;
    align-items: stretch;
    min-height: calc(100vh - 5rem);
    padding: var(--space-4);
  }

  .bezel {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    border: 3px solid var(--border);
    background: var(--bg);
    box-shadow: inset 0 0 3rem color-mix(in srgb, var(--text) 8%, transparent);
  }

  .bezel-chrome {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .led {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent-status);
  }

  .chrome-buttons {
    display: inline-flex;
    gap: 0.25rem;
    margin-left: auto;
  }

  .chrome-buttons span {
    width: 0.4rem;
    height: 0.4rem;
    border: 1px solid var(--border);
  }

  .screen {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: var(--space-12) var(--space-8);
  }

  .scanlines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 3px,
      color-mix(in srgb, var(--text) 4%, transparent) 4px
    );
  }

  .terminal-body {
    max-width: 46rem;
    margin: 0 auto;
    text-align: left;
  }

  .boot-line {
    position: relative;
    margin: 0 0 var(--space-1);
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    white-space: nowrap;
  }

  .module-line {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-left: 1.5em;
    color: var(--text-secondary);
  }

  .module-name {
    display: inline-block;
    min-width: 15ch;
  }

  .progress-bar {
    display: inline-flex;
    width: 5rem;
    height: 0.5rem;
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .progress-fill {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent-status);
    animation: progress-fill-in 0.35s steps(8, end) forwards;
  }

  @keyframes progress-fill-in {
    to {
      width: 100%;
    }
  }

  .module-status {
    color: var(--accent-status);
    opacity: 0;
    animation: instant-reveal 0.01s steps(1) forwards;
  }

  @keyframes instant-reveal {
    to {
      opacity: 1;
    }
  }

  .prompt-response {
    color: var(--text-secondary);
  }

  .operator-line {
    white-space: normal;
  }

  .prompt-glyph {
    color: var(--accent-primary);
  }

  .comment-glyph {
    color: var(--text-secondary);
  }

  .typed {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    width: 0;
    animation-name: type-reveal;
    animation-fill-mode: forwards;
  }

  @keyframes type-reveal {
    from {
      width: 0;
    }
  }

  .caret {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.25em;
    background: var(--accent-status);
    vertical-align: text-bottom;
    opacity: 0;
    animation:
      caret-appear 0s forwards,
      caret-blink 1s steps(1) infinite;
    /* animation-delay set inline per-instance (see markup) — overrides any value here. */
  }

  /* The operator-response line wraps (see the frontmatter note on why it can't use
     `.typed`) and reveals as a plain delayed block instead. */
  .line-reveal {
    opacity: 0;
    animation: instant-reveal 0.01s steps(1) forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
      opacity: 1;
    }

    .typed {
      width: auto !important;
      animation: none;
    }

    .module-status {
      opacity: 1;
      animation: none;
    }

    .progress-fill {
      width: 100%;
      animation: none;
    }

    .line-reveal {
      opacity: 1;
      animation: none;
    }
  }

  @keyframes caret-appear {
    to {
      opacity: 1;
    }
  }

  @keyframes caret-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .headline {
    position: relative;
    margin: var(--space-6) 0 0;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(1.375rem, 1.4vw + 1.2rem, 2.125rem);
    line-height: 1.5;
    color: var(--text);
    white-space: normal;
  }

  .subhead {
    position: relative;
    margin: var(--space-3) 0 0;
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text-secondary);
    white-space: normal;
  }

  .cta-wrap {
    margin: var(--space-4) 0 0;
  }

  /* Full-viewport-height stretching reads as "a maximized terminal window" on desktop,
     but on a short/narrow viewport it just leaves a large empty gap below the content —
     fall back to intrinsic content height there instead. */
  @media (max-width: 40rem) {
    .hero {
      align-items: center;
      min-height: auto;
    }
  }
</style>
