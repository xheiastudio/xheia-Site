---
// Mark, tagline headline, one-line outcome-framed subhead, CTA — wrapped in the CRT/
// boot-sequence bezel with terminal-prompt flourish (typewriter reveal, blinking caret,
// $ whoami-style lines). SPEC.md is explicit: the literal boot-sequence device (typed
// terminal lines, chrome-buttons bar) stays Hero-exclusive — don't duplicate it
// elsewhere. The broader pixel-art system (rivets, cursor, scanlines) now extends
// site-wide as of the big visual pass — see BRANDFINAL.md's Visual Identity section.
//
// Headline is the approved tagline verbatim (BRANDFINAL.md — Tagline). Subhead is
// outcome-framed per BRANDFINAL §2 ("lead with what the client gets, not the AI
// label"), grounded in §5's "Clarity is engineered, not promised" pillar — full
// lifecycle discipline is what makes any AI layer trustworthy — no new claims invented.
import PixelMark from './PixelMark.astro';
import PixelRivets from './PixelRivets.astro';
import CTAButton from './CTAButton.astro';
---

<section class="hero">
  <div class="bezel">
    <PixelRivets />

    <div class="bezel-chrome">
      <span class="led" aria-hidden="true"></span>
      <span class="bezel-label">xheia_terminal</span>
      <span class="chrome-buttons" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </div>

    <div class="screen">
      <div class="scanlines" aria-hidden="true"></div>

      <p class="prompt-line">
        <span class="prompt-glyph">$</span> <span class="typed typed-1">whoami</span>
      </p>
      <p class="prompt-line prompt-response">
        <span class="prompt-glyph">&gt;</span> <span class="typed typed-2"
          >full-stack data consultant</span
        ><span class="caret" aria-hidden="true"></span>
      </p>

      <div class="brand-row">
        <PixelMark size={40} />
        <span class="wordmark">xheia</span>
      </div>

      <h1 class="headline">I turn fragmented data into systems you can actually trust.</h1>

      <p class="subhead">
        Full-lifecycle data work — cleansing, migration, warehousing, BI — so any AI you
        build on top actually holds up.
      </p>

      <CTAButton class="hero-cta" />
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    justify-content: center;
    padding: var(--space-8) var(--space-4);
  }

  .bezel {
    position: relative;
    width: 100%;
    max-width: var(--content-max-width);
    border: 3px solid var(--border);
    background: var(--bg);
    box-shadow: inset 0 0 3rem color-mix(in srgb, var(--text) 8%, transparent);
  }

  .bezel-chrome {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .led {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent-status);
  }

  .chrome-buttons {
    display: inline-flex;
    gap: 0.25rem;
    margin-left: auto;
  }

  .chrome-buttons span {
    width: 0.4rem;
    height: 0.4rem;
    border: 1px solid var(--border);
  }

  .screen {
    position: relative;
    overflow: hidden;
    padding: var(--space-12) var(--space-6);
    text-align: center;
  }

  .scanlines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 3px,
      color-mix(in srgb, var(--text) 4%, transparent) 4px
    );
  }

  .prompt-line {
    position: relative;
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-align: left;
    max-width: 24rem;
    margin-inline: auto;
    white-space: nowrap;
  }

  .prompt-response {
    color: var(--text-secondary);
  }

  .prompt-glyph {
    color: var(--accent-primary);
  }

  .typed {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    width: 0;
    animation-timing-function: steps(30, end);
    animation-fill-mode: forwards;
  }

  .typed-1 {
    width: 6ch;
    animation-name: type-reveal;
    animation-duration: 0.4s;
  }

  .typed-2 {
    width: 27ch;
    animation-name: type-reveal;
    animation-duration: 1s;
    animation-delay: 0.5s;
  }

  @keyframes type-reveal {
    from {
      width: 0;
    }
  }

  .caret {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.25em;
    background: var(--accent-status);
    vertical-align: text-bottom;
    opacity: 0;
    animation:
      caret-appear 0s forwards 1.5s,
      caret-blink 1s steps(1) infinite 1.5s;
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
      opacity: 1;
    }

    .typed {
      width: auto !important;
      animation: none;
    }
  }

  @keyframes caret-appear {
    to {
      opacity: 1;
    }
  }

  @keyframes caret-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .brand-row {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-8) 0 var(--space-6);
  }

  .brand-row .wordmark {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 500;
  }

  .headline {
    position: relative;
    max-width: 40rem;
    margin: 0 auto var(--space-6);
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.4vw + 0.5rem, 1.75rem);
    line-height: 1.6;
    white-space: normal;
  }

  .subhead {
    position: relative;
    max-width: 32rem;
    margin: 0 auto var(--space-8);
    color: var(--text-secondary);
    font-size: 1.0625rem;
    white-space: normal;
  }
</style>
