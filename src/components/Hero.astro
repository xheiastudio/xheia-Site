---
// Mark, tagline headline, one-line outcome-framed subhead, CTA — wrapped in the CRT/
// boot-sequence bezel with terminal-prompt flourish (blinking caret, $ whoami-style
// lines). SPEC.md is explicit: Hero is the ONLY component allowed to use these
// motion/CRT effects — don't reuse this bezel or the caret-blink animation elsewhere.
//
// Headline is the approved tagline verbatim (BRANDFINAL.md — Tagline). Subhead is
// outcome-framed per BRANDFINAL §2 ("lead with what the client gets, not the AI
// label"), grounded in §5's "Clarity is engineered, not promised" pillar — full
// lifecycle discipline is what makes any AI layer trustworthy — no new claims invented.
import PixelMark from './PixelMark.astro';
import CTAButton from './CTAButton.astro';
---

<section class="hero">
  <div class="bezel">
    <div class="bezel-chrome">
      <span class="led" aria-hidden="true"></span>
      <span class="bezel-label">xheia_terminal</span>
    </div>

    <div class="screen">
      <div class="scanlines" aria-hidden="true"></div>

      <p class="prompt-line">
        <span class="prompt-glyph">$</span> whoami<span class="caret" aria-hidden="true"
        ></span>
      </p>
      <p class="prompt-line prompt-response">&gt; full-stack data consultant</p>

      <div class="brand-row">
        <PixelMark size={40} />
        <span class="wordmark">xheia</span>
      </div>

      <h1 class="headline">We turn fragmented data into systems you can actually trust.</h1>

      <p class="subhead">
        Full-lifecycle data work — cleansing, migration, warehousing, BI — so any AI you
        build on top actually holds up.
      </p>

      <CTAButton class="hero-cta" />
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    justify-content: center;
    padding: var(--space-8) var(--space-4);
  }

  .bezel {
    width: 100%;
    max-width: var(--content-max-width);
    border: 2px solid var(--border);
    background: var(--bg);
  }

  .bezel-chrome {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .led {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent-status);
  }

  .screen {
    position: relative;
    overflow: hidden;
    padding: var(--space-12) var(--space-6);
    text-align: center;
  }

  .scanlines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 3px,
      color-mix(in srgb, var(--text) 4%, transparent) 4px
    );
  }

  .prompt-line {
    position: relative;
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-align: left;
    max-width: 24rem;
    margin-inline: auto;
  }

  .prompt-response {
    color: var(--text-secondary);
  }

  .prompt-glyph {
    color: var(--accent-primary);
  }

  .caret {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.25em;
    background: var(--accent-status);
    vertical-align: text-bottom;
    animation: caret-blink 1s steps(1) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }

  @keyframes caret-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .brand-row {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-8) 0 var(--space-6);
  }

  .brand-row .wordmark {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 500;
  }

  .headline {
    position: relative;
    max-width: 40rem;
    margin: 0 auto var(--space-6);
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.4vw + 0.5rem, 1.75rem);
    line-height: 1.6;
  }

  .subhead {
    position: relative;
    max-width: 32rem;
    margin: 0 auto var(--space-8);
    color: var(--text-secondary);
    font-size: 1.0625rem;
  }
</style>
