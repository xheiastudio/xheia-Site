---
// Single shared CTA, site-wide: same label, same destination, every time (SPEC.md — Nav).
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a href="/contact" class:list={['cta-button', className]}>Start a conversation</a>

<style>
  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--accent-primary);
    border-radius: var(--radius);
    background: var(--accent-primary);
    color: var(--on-accent-primary);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.15s ease;
  }

  .cta-button:hover,
  .cta-button:focus-visible {
    opacity: 0.85;
  }
</style>
