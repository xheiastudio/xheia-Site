---
// Single shared CTA, site-wide: same label, same destination, every time (SPEC.md — Nav).
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a href="/contact" class:list={['cta-button', 'pixel-notch', className]}>Start a conversation</a>

<style>
  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--accent-primary-fill);
    border-radius: var(--radius);
    background: var(--accent-primary-fill);
    color: var(--on-accent-primary);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 0 0 0 transparent;
    transition:
      background-color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* buttons.md: "Always include a press state for a custom button. Without a press
     state, a button can feel unresponsive." This had hover/focus but nothing for
     :active - on a touch device (no hover at all) tapping gave zero feedback
     before the page navigated away. */
  .cta-button:active {
    transform: scale(0.96);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-button:active {
      transform: none;
    }
  }

  .cta-button::before {
    content: '>';
    width: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      width 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Text-on-transparent (revealing the page background) - the same scenario
     --accent-primary-text exists for (full audit finding: raw --accent-primary here
     measured 4.22:1 against Ink in dark mode, below the 4.5:1 text minimum).
     The glow (same soft bloom now on PixelCursor/ThemeToggle/the logo) sits OUTSIDE
     the clip-path fine since box-shadow's outward spread isn't clipped the way an
     outline would be - only the inset focus ring below needs that workaround. */
  .cta-button:hover,
  .cta-button:focus-visible {
    background: transparent;
    color: var(--accent-primary-text);
    box-shadow: 0 0 1rem -0.2rem color-mix(in srgb, var(--accent-primary) 55%, transparent);
  }

  /* Light mode needs a materially bolder glow than the dark-mode value to read as a
     real bloom against Paper (Weber-Fechner - the same percentage shift is obvious
     near black, nearly imperceptible near white) - same finding as every other glow
     on the site, verified rather than guessed. */
  :global(html[data-theme='light']) .cta-button:hover,
  :global(html[data-theme='light']) .cta-button:focus-visible {
    box-shadow: 0 0 1.25rem 0 color-mix(in srgb, var(--accent-primary) 85%, transparent);
  }

  /* clip-path (.pixel-notch) cuts two corners off the box, so an outward `outline`
     would get clipped away right where it's cut — invisible/broken focus ring. An
     inset ring stays inside the clipped shape instead. Matches the hover-state text
     color above (both are the same "accent-on-transparent" moment) rather than the
     plain --accent-primary token. Combined with the outward glow above (two
     box-shadow layers, comma-separated) rather than replacing it - the inset ring is
     the accessibility-required indicator, the outward glow is the same decorative
     bloom every hover state gets. */
  .cta-button:focus-visible {
    outline: none;
    box-shadow:
      inset 0 0 0 2px var(--accent-primary-text),
      0 0 1rem -0.2rem color-mix(in srgb, var(--accent-primary) 55%, transparent);
  }

  :global(html[data-theme='light']) .cta-button:focus-visible {
    box-shadow:
      inset 0 0 0 2px var(--accent-primary-text),
      0 0 1.25rem 0 color-mix(in srgb, var(--accent-primary) 85%, transparent);
  }

  .cta-button:hover::before,
  .cta-button:focus-visible::before {
    width: 1ch;
    opacity: 1;
  }
</style>
