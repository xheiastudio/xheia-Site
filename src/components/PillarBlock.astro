---
// Three messaging pillars, relocated from Home to /approach as part of the structural
// redesign. Copy condensed directly from BRANDFINAL.md §5 — no new pillar language
// invented (SPEC.md — PillarBlock).
//
// This section is the ORIGIN of the bar-fill-then-checkmark "boot check" visual — it
// used to play per-pillar on click (native <details>/<summary>: indicator dot + title
// in the summary row, then a bar on its own line below, then a ✓-prefixed body
// paragraph once opened). Reworked to auto-load instead, staggered one pillar after
// another as the section scrolls into view — same visual, same layout, just triggered
// by scroll instead of a click. The bar is the shared `SectionLoader` component
// (src/components/SectionLoader.astro); the checkmark stays what it always was, a
// plain glyph prefixing the body text, not part of the bar.
//
// Individual per-pillar boxes (border + tinted background) removed - "pixelated but
// Apple" pass: the outer .pillar-block frame is the section's one box; boxing each
// pillar again inside it was boxes-within-boxes, the exact density this pass exists
// to cut. Whitespace (a bigger .checks gap) does the separating instead.
import SectionLoader from './SectionLoader.astro';
import SectionNumber from './SectionNumber.astro';

const ITEM_STAGGER = 0.35;

const pillars = [
  {
    title: 'Truth over theatre',
    body: 'Every claim on this site is backed by delivered work, described plainly. No hype, no vendor theatre.',
  },
  {
    title: 'Clarity is engineered, not promised',
    body: 'Full-lifecycle discipline - ingestion, cleansing, warehousing, BI - is what makes anything built on top of the data actually trustworthy.',
  },
  {
    title: 'Built to survive scrutiny',
    body: 'Security-conscious, evidence-based, documented - not a pitch that only holds up in the room it was delivered in.',
  },
];
---

<section class="pillar-block" data-reveal>
  <div class="section-head">
    <SectionNumber number="02" />
    <h2 class="eyebrow">// principles</h2>
  </div>
  <div class="checks">
    {
      pillars.map((pillar, i) => {
        const delay = i * ITEM_STAGGER;
        return (
          <div class="check-item">
            <div class="check-head item-content" style={{ transitionDelay: `${delay}s` }}>
              <span class="check-indicator" aria-hidden="true" />
              <h3 class="check-title">{pillar.title}</h3>
            </div>
            <div class="check-result">
              <SectionLoader delay={delay} />
              <p class="check-body item-content" style={{ transitionDelay: `${delay + 0.5}s` }}>
                <span class="check-mark" aria-hidden="true">✓</span> {pillar.body}
              </p>
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .pillar-block {
    width: min(100% - 2 * var(--space-4), var(--content-max-width));
    margin: var(--space-16) auto;
    padding: var(--space-12);
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--text) 3%, transparent);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.875rem;
    line-height: 1.5;
    letter-spacing: 0.06em;
    color: var(--accent-primary);
  }

  .checks {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .check-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .check-indicator {
    flex-shrink: 0;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--accent-status);
  }

  .check-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .check-result {
    margin-top: var(--space-4);
    padding-left: calc(0.6rem + var(--space-3));
  }

  .check-body {
    margin: var(--space-3) 0 0;
    color: var(--text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .check-mark {
    color: var(--accent-status);
  }

  /* Flare coral (light mode's --accent-status) is 2.04:1 on Paper as text — fails
     WCAG's 4.5:1 minimum (Apple HIG design-review pass). Coral stays for the
     decorative bar fill (not text, no minimum applies the same way); the glyph
     itself switches to --text (Ink, 17:1 on Paper) in light mode only. Dark mode's
     Signal green checkmark (12.9:1) is unaffected. */
  :global(html[data-theme='light']) .check-mark {
    color: var(--text);
  }
</style>
