---
// Three messaging pillars, relocated from Home to /approach as part of the structural
// redesign. Copy condensed directly from BRANDFINAL.md §5 — no new pillar language
// invented (SPEC.md — PillarBlock).
//
// This section is the ORIGIN of the bar-fill-then-checkmark "boot check" visual, and
// (full-redesign pass) is back to its original click-to-expand form: native
// <details>/<summary>, closed by default - indicator dot + ▶ selector + title in the
// summary row, then a bar, then a ✓-prefixed body paragraph once opened. An
// intervening pass had reworked this into everything auto-revealing on scroll;
// reverted per direct feedback that the page read as "loads of writing" with no real
// design applied to it - apple-design's layout.md names progressive disclosure as
// the fix for exactly this ("don't obscure [content] by crowding it with nonessential
// details"). See Capabilities.astro's matching comment and
// src/scripts/disclosure.ts for the shared smooth-height enhancement.
//
// Individual per-pillar boxes (border + tinted background) removed - "pixelated but
// Apple" pass: the outer .pillar-block frame is the section's one box; boxing each
// pillar again inside it was boxes-within-boxes, the exact density this pass exists
// to cut. Whitespace (a bigger .checks gap) does the separating instead.
import SectionLoader from './SectionLoader.astro';
import SectionNumber from './SectionNumber.astro';

const ITEM_STAGGER = 0.35;

const pillars = [
  {
    title: 'Truth over theatre',
    body: 'Every claim on this site is backed by delivered work, described plainly. No hype, no vendor theatre.',
  },
  {
    title: 'Clarity is engineered, not promised',
    body: 'Full-lifecycle discipline - ingestion, cleansing, warehousing, BI - is what makes anything built on top of the data actually trustworthy.',
  },
  {
    title: 'Built to survive scrutiny',
    body: 'Security-conscious, evidence-based, documented - not a pitch that only holds up in the room it was delivered in.',
  },
];
---

<section class="pillar-block" data-reveal>
  <div class="section-head">
    <SectionNumber number="02" />
    <h2 class="eyebrow">// principles</h2>
  </div>
  <div class="checks">
    {
      pillars.map((pillar, i) => {
        const delay = i * ITEM_STAGGER;
        return (
          <details class="check-item">
            <summary class="check-head item-content" style={{ transitionDelay: `${delay}s` }}>
              <span class="check-indicator" aria-hidden="true" />
              <span class="selector" aria-hidden="true">▶</span>
              <h3 class="check-title">{pillar.title}</h3>
            </summary>
            <div class="check-result">
              <SectionLoader />
              <p class="check-body">
                <span class="check-mark" aria-hidden="true">✓</span> {pillar.body}
              </p>
            </div>
          </details>
        );
      })
    }
  </div>
</section>

<script>
  import { initDisclosure } from '../scripts/disclosure';

  document.addEventListener('astro:page-load', () => {
    initDisclosure('.pillar-block .check-item', '.check-result');
  });
</script>

<style>
  /* No border/tinted background - see Capabilities.astro's equivalent comment: Home's
     whitespace-only framing overrides the earlier "one frame per section" standard. */
  .pillar-block {
    width: min(100% - 2 * var(--space-4), var(--content-max-width));
    margin: var(--space-20) auto;
    padding: 0;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  /* --accent-primary-text, not --accent-primary: see Capabilities.astro's equivalent
     comment (full audit finding, raw --accent-primary is 4.22:1 against Ink in dark
     mode, below the 4.5:1 text minimum). */
  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.875rem;
    line-height: 1.5;
    letter-spacing: 0.06em;
    color: var(--accent-primary-text);
  }

  .checks {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* Each item is a real <details> now - no default marker (the ▶ selector glyph
     does that job by rotating, same as Capabilities). */
  .check-item {
    list-style: none;
  }

  .check-item summary {
    list-style: none;
    cursor: pointer;
    border-radius: var(--radius);
  }

  .check-item summary::-webkit-details-marker {
    display: none;
  }

  .check-head {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  /* summary is now the real interactive control - real hover/focus affordance,
     matching every other control on the site (and Capabilities' equivalent). */
  .check-item summary:hover .check-title,
  .check-item summary:focus-visible .check-title {
    color: var(--accent-primary-text);
  }

  .check-item summary:focus-visible {
    outline: 2px solid var(--accent-primary-text);
    outline-offset: 3px;
  }

  .check-indicator {
    flex-shrink: 0;
    width: 0.6rem;
    height: 0.6rem;
    margin-top: 0.45em;
    border-radius: 50%;
    background: var(--accent-status);
  }

  /* Light mode's coral is noticeably flatter than dark mode's glowing signal green -
     a small halo gives it the same "alive" quality dark mode gets for free from the
     color itself. */
  :global(html[data-theme='light']) .check-indicator {
    box-shadow: 0 0 0.5rem 0.05rem color-mix(in srgb, var(--accent-status) 70%, transparent);
  }

  /* Rotates to point down when open - same "item marker that doubles as an expand
     affordance" as Capabilities' selector. */
  .selector {
    display: inline-block;
    margin-top: 0.05em;
    color: var(--accent-primary-text);
    font-size: 0.875rem;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .check-item[open] .selector {
    transform: rotate(90deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .selector {
      transition: none;
    }
  }

  /* font-mono, not font-display: see Capabilities.astro's equivalent comment - full
     redesign pass, matching Home's headline (100% IBM Plex Mono) instead of mixing
     in the pixel font on real item titles. */
  .check-title {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 1.0625rem;
    line-height: 1.5;
    transition: color 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .check-result {
    margin-top: var(--space-4);
    padding-left: calc(0.6rem + var(--space-3) * 2 + 1rem);
    overflow: hidden;
  }

  /* This section's bars now play per-item on open, not once for everyone when the
     section scrolls into view - see Capabilities.astro's matching comment for why
     this specificity reliably overrides global.css's scroll-triggered default. */
  [data-reveal].is-visible .check-item .loader-bar-fill {
    width: 0;
    animation: none;
  }

  .check-item[open] .loader-bar-fill {
    animation: section-loader-fill 0.5s steps(10, end) forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .check-item[open] .loader-bar-fill {
      width: 100%;
      animation: none;
    }
  }

  .check-body {
    margin: var(--space-3) 0 0;
    color: var(--text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .check-mark {
    color: var(--accent-status);
  }

  /* Flare coral (light mode's --accent-status) is 2.04:1 on Paper as text — fails
     WCAG's 4.5:1 minimum (Apple HIG design-review pass). Coral stays for the
     decorative bar fill (not text, no minimum applies the same way); the glyph
     itself switches to --text (Ink, 17:1 on Paper) in light mode only. Dark mode's
     Signal green checkmark (12.9:1) is unaffected. */
  :global(html[data-theme='light']) .check-mark {
    color: var(--text);
  }
</style>
