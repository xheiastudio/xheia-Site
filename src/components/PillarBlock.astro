---
// Three messaging pillars, copy condensed directly from BRANDFINAL.md §5 — no new
// pillar language invented (SPEC.md — PillarBlock).
const pillars = [
  {
    title: 'Truth over theater',
    body: 'No vendor hype, no overselling AI readiness — every claim is backed by delivered work, described plainly.',
  },
  {
    title: 'Clarity is engineered, not promised',
    body: 'Full-lifecycle discipline — ingestion, cleansing, warehousing, BI — is what makes any AI layer trustworthy.',
  },
  {
    title: 'Built to survive scrutiny',
    body: 'Security-conscious, evidence-based, documented — built to hold up, not just a pitch that works in the room it was delivered in.',
  },
];
---

<section class="pillar-block">
  {
    pillars.map((pillar) => (
      <article class="pillar">
        <h3>{pillar.title}</h3>
        <p>{pillar.body}</p>
      </article>
    ))
  }
</section>

<style>
  .pillar-block {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-6);
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .pillar h3 {
    font-size: 1rem;
    margin-bottom: var(--space-2);
  }

  .pillar p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }
</style>
