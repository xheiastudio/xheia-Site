---
// Wordmark, social links, terminal flavor line, status dot (SPEC.md — Footer).
// Static text only — the blinking-caret/CRT terminal treatment is Hero-exclusive.
// Personal credit line + LinkedIn slots added per the identity/discoverability pass —
// see SPEC.md's revision note. Name and LinkedIn URLs are placeholders until supplied.
import PixelMark from './PixelMark.astro';

const socialLinks = [
  { label: 'GitHub', href: '#' }, // TODO: replace with real GitHub URL
  { label: 'LinkedIn', href: '#' }, // TODO: replace with real personal LinkedIn URL
  { label: 'Xheia · LinkedIn', href: '#' }, // TODO: link once the Xheia company page has real content — don't link an empty page
];
---

<footer class="site-footer">
  <div class="brand">
    <div class="brand-mark">
      <PixelMark size={18} />
      <span class="wordmark">xheia</span>
    </div>
    <p class="credit">Built and run by [Your Name].</p>
  </div>

  <nav aria-label="Social">
    {socialLinks.map((s) => <a href={s.href}>{s.label}</a>)}
  </nav>

  <p class="flavor-line">
    <span class="status-dot" aria-hidden="true"></span>
    $ status: operational
  </p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
  }

  .wordmark {
    font-weight: 500;
  }

  .credit {
    margin: 0;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  nav {
    display: flex;
    gap: var(--space-4);
  }

  nav a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--accent-primary);
  }

  .flavor-line {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent-status);
  }
</style>
