---
// Wordmark, social links, terminal flavor line, status dot (SPEC.md — Footer).
// Static text only — the blinking-caret/CRT terminal treatment is Hero-exclusive.
// Personal credit line + LinkedIn slots added per the identity/discoverability pass —
// see SPEC.md's revision note. Name resolved to Hoda in the real-content pass;
// LinkedIn/GitHub URLs are still placeholders until supplied.
//
// Apple-sleekness pass: dropped the flat `border-top` divider in favor of generous
// whitespace above it - the same "whitespace does the framing job the border used
// to do" move already applied to Hero's bezel. Fades in on scroll (data-reveal, the
// site's sitewide mechanism) instead of just sitting there from first paint, and nav
// links get a real color transition instead of an instant snap.
import PixelMark from './PixelMark.astro';

const socialLinks = [
  { label: 'GitHub', href: '#' }, // TODO: replace with real GitHub URL
  { label: 'LinkedIn', href: '#' }, // TODO: replace with real personal LinkedIn URL
  { label: 'Xheia · LinkedIn', href: '#' }, // TODO: link once the Xheia company page has real content — don't link an empty page
];
---

<footer class="site-footer" data-reveal>
  <div class="brand">
    <div class="brand-mark">
      <PixelMark size={24} />
      <span class="wordmark">xheia</span>
    </div>
    <p class="credit">Built and run by Hoda.</p>
  </div>

  <nav aria-label="Social">
    {socialLinks.map((s) => <a href={s.href}>{s.label}</a>)}
  </nav>

  <p class="flavor-line">
    <span class="status-dot" aria-hidden="true"></span>
    $ status: operational
  </p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: calc(var(--space-16) + var(--space-8)) var(--space-4) var(--space-12);
    font-family: var(--font-mono);
    /* typography.md's macOS translation: 13pt default / 10pt minimum (~17px/~13px).
       This was 0.8125rem (13px), right at that minimum with no margin - bumped for
       a real one. */
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
  }

  .wordmark {
    font-weight: 500;
  }

  .credit {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  nav {
    display: flex;
    gap: var(--space-4);
  }

  nav a {
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: var(--radius);
    transition: color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--accent-primary);
  }

  /* Color alone isn't a visible keyboard-focus indicator (accessibility.md - WCAG
     2.4.7 Focus Visible) - a muted-gray-to-blue shift is easy to miss entirely. */
  nav a:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 3px;
  }

  .flavor-line {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent-status);
    animation: status-pulse 2s ease-in-out infinite;
  }

  @keyframes status-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot {
      animation: none;
    }
  }
</style>
