---
// Wordmark, social links, terminal flavor line, status dot (SPEC.md — Footer).
// Static text only — the blinking-caret/CRT terminal treatment is Hero-exclusive.
import PixelMark from './PixelMark.astro';

// TODO: replace with real profile URLs before launch.
const socialLinks = [
  { label: 'GitHub', href: '#' },
  { label: 'LinkedIn', href: '#' },
];
---

<footer class="site-footer">
  <div class="brand">
    <PixelMark size={18} />
    <span class="wordmark">xheia</span>
  </div>

  <nav aria-label="Social">
    {socialLinks.map((s) => <a href={s.href}>{s.label}</a>)}
  </nav>

  <p class="flavor-line">
    <span class="status-dot" aria-hidden="true"></span>
    $ status: operational
  </p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
  }

  .wordmark {
    font-weight: 500;
  }

  nav {
    display: flex;
    gap: var(--space-4);
  }

  nav a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--accent-primary);
  }

  .flavor-line {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent-status);
  }
</style>
