---
// Small dedicated tools section on /approach, per the real-content pass — grounded
// directly in xheia-content-worksheet.md's confirmed stack, nothing invented. Reuses
// CaseStudyCard's existing pixel-tag visual pattern (.tags li) for consistency rather
// than introducing a new tag style.
const tools = [
  'Azure Synapse',
  'Power BI',
  'Power Automate',
  'SharePoint',
  'HubSpot',
  'Apollo',
  'Python',
  'SQL',
  'Microsoft Foundry',
  'rapidfuzz',
  'Claude Code',
];
---

<section class="tools" data-reveal>
  <p class="eyebrow">// tools</p>
  <ul class="tags">
    {tools.map((tool) => <li>{tool}</li>)}
  </ul>
</section>

<style>
  .tools {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
    border-top: 1px solid var(--border);
  }

  .eyebrow {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--accent-primary);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.125rem var(--space-2);
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-secondary);
  }

</style>
