---
// Small dedicated tools section on /approach, per the real-content pass — grounded
// directly in xheia-content-worksheet.md's confirmed stack, nothing invented. Copy V2
// pass condensed the 11 individual tools into grouped tags (still the same real
// stack, just fewer/grouped labels).
//
// Rebuilt from a flat pixel-tag list into a real "stack manifest" (Apple HIG design-
// improvement pass — the user directly called out that incremental CSS nudges here
// weren't a real transformation): each tool is its own numbered row, mono-spaced
// like a terminal `ls` listing, tying into the same numbering motif as /approach's
// section numerals instead of just being five identical pills. Deliberately no
// SectionLoader/typed reveal — a flat list of short labels doesn't carry enough
// meaning per item to justify a "boot check," unlike Capabilities/PillarBlock's named
// modules; the whole manifest still fades in as a group on scroll (.section-content).
import SectionNumber from './SectionNumber.astro';

const tools = [
  'Microsoft data & AI stack (Azure, Power BI, Foundry)',
  'Python',
  'SQL',
  'Power Automate',
  'Claude Code',
];
---

<section class="tools" data-reveal>
  <div class="section-head">
    <SectionNumber number="04" />
    <h2 class="eyebrow">// tools</h2>
  </div>
  <div class="tools-frame">
    <p class="frame-label">stack manifest</p>
    <ol class="manifest section-content">
      {
        tools.map((tool, i) => (
          <li class="manifest-row">
            <span class="row-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="row-name">{tool}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .tools {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-16) var(--space-4);
    border-top: 1px solid var(--border);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.875rem;
    line-height: 1.5;
    letter-spacing: 0.06em;
    color: var(--accent-primary);
  }

  .tools-frame {
    border: 1px solid var(--border);
  }

  .frame-label {
    margin: 0;
    padding: var(--space-3) var(--space-6);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  .manifest {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .manifest-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-6);
    padding: var(--space-5) var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .manifest-row:last-child {
    border-bottom: none;
  }

  .row-index {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.125rem;
    color: var(--accent-primary);
  }

  .row-name {
    font-family: var(--font-mono);
    font-size: 1.1875rem;
    font-weight: 500;
    color: var(--text);
  }

  @media (max-width: 40rem) {
    .manifest-row {
      gap: var(--space-4);
      padding: var(--space-4);
    }

    .row-name {
      font-size: 1.0625rem;
    }
  }
</style>
