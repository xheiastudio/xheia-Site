---
// Small dedicated tools section on /approach, per the real-content pass — grounded
// directly in xheia-content-worksheet.md's confirmed stack, nothing invented. Reuses
// CaseStudyCard's existing pixel-tag visual pattern (.tags li) for consistency rather
// than introducing a new tag style. Copy V2 pass condensed the 11 individual tools
// into grouped tags (still the same real stack, just fewer/grouped labels).
//
// Deliberately no SectionLoader here — a boot-check bar next to a flat tag list read
// as visual noise, not a meaningful "load" (unlike Capabilities/PillarBlock's named
// modules). The tag list just fades in as a group on scroll (.section-content, see
// src/styles/global.css), same as the rest of the site's data-reveal sections.

const tools = [
  'Microsoft data & AI stack (Azure, Power BI, Foundry)',
  'Python',
  'SQL',
  'Power Automate',
  'Claude Code',
];
---

<section class="tools" data-reveal>
  <p class="eyebrow">// tools</p>
  <ul class="tags section-content">
    {tools.map((tool) => <li>{tool}</li>)}
  </ul>
</section>

<style>
  .tools {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-16) var(--space-4);
    border-top: 1px solid var(--border);
  }

  .eyebrow {
    margin: 0 0 var(--space-6);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    color: var(--accent-primary);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
</style>
