---
// One phase within EngagementStructure (SPEC.md — EngagementStructure / EngagementPhase).
// Order number escalated to a big chunky display-font numeral, hover upgraded from a
// left-border accent to a pixel-jitter snap — site-wide pixel/retro visual pass.
interface Props {
  order: number;
  title: string;
  body: string;
}

const { order, title, body } = Astro.props;
---

<article class="engagement-phase pixel-jitter-hover">
  <p class="order">{String(order).padStart(2, '0')}</p>
  <h3>{title}</h3>
  <p class="body">{body}</p>
</article>

<style>
  .engagement-phase {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .engagement-phase:hover {
    animation: pixel-jitter 0.3s steps(4);
  }

  .engagement-phase:hover .order {
    color: var(--accent-status);
  }

  .order {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
    color: var(--accent-primary);
    transition: color 0.15s ease;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .body {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }
</style>
