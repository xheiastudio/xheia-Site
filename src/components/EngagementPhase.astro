---
// One node on EngagementStructure's level-path (SPEC.md — EngagementStructure /
// EngagementPhase). Content is always visible once revealed (no progressive
// disclosure, unlike Capabilities/PillarBlock's items) — hover on the marker is
// decorative feedback only.
//
// Fades in staggered one after another as the section scrolls into view (keyed off
// the parent's data-reveal .is-visible, src/styles/global.css) — but deliberately NO
// SectionLoader bar here: unlike Capabilities/PillarBlock's named modules, these are
// short step labels (Discovery/Build/Handoff) where a boot-check bar read as visual
// noise rather than a meaningful "load." `delay` (seconds) is computed by
// EngagementStructure.astro from this node's position in the sequence.
interface Props {
  order: number;
  title: string;
  body: string;
  delay: number;
}

const { order, title, body, delay } = Astro.props;
---

<div class="node item-content" style={{ transitionDelay: `${delay}s` }}>
  <div class="node-marker" aria-hidden="true">{order}</div>
  <div class="node-content">
    <h3>{title}</h3>
    <p>{body}</p>
  </div>
</div>

<style>
  .node {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    gap: var(--space-3);
    padding: 0 var(--space-2);
    text-align: center;
  }

  .node-marker {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border: 2px solid var(--accent-primary);
    background: var(--bg);
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--accent-primary);
    /* Was plain ease on all three properties - found on a full sweep matching this
       to the site's established cubic-bezier(0.16,1,0.3,1) curve. */
    transition:
      background-color 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .node:hover .node-marker {
    background: var(--accent-status);
    border-color: var(--accent-status);
    color: var(--bg);
  }

  .node-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .node h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.25rem;
    line-height: 1.6;
    margin: 0;
  }

  .node p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 1.0625rem;
  }

  @media (max-width: 40rem) {
    .node {
      flex-direction: row;
      align-items: flex-start;
      text-align: left;
      width: 100%;
    }

    .node-marker {
      flex-shrink: 0;
    }
  }
</style>
