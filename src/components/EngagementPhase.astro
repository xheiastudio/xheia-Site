---
// One phase within EngagementStructure (SPEC.md — EngagementStructure / EngagementPhase).
interface Props {
  order: number;
  title: string;
  body: string;
}

const { order, title, body } = Astro.props;
---

<article class="engagement-phase">
  <p class="order">{String(order).padStart(2, '0')}</p>
  <h3>{title}</h3>
  <p class="body">{body}</p>
</article>

<style>
  .engagement-phase {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    margin: calc(var(--space-3) * -1);
    border-left: 1px solid transparent;
    transition: border-color 0.15s ease;
  }

  .engagement-phase:hover {
    border-left-color: var(--accent-primary);
  }

  .order {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent-primary);
  }

  h3 {
    margin: 0;
    font-size: 1.0625rem;
  }

  .body {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }
</style>
