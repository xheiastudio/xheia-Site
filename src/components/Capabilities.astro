---
// "What I do," relocated from Home to /approach as part of the structural redesign —
// grounded in BRANDFINAL §1 "What I do", no invented claims, no past-client language.
// Links to /work for the actual proof.
//
// Redesigned as a boot-menu / select-screen (native <details>/<summary> — real keyboard
// and screen-reader support for free, degrades to a plain expandable list without JS)
// instead of three identical bordered tiles, per the "boxes under boxes" feedback: each
// relocated section now gets its own distinct interaction rather than repeating one
// card pattern. See BRANDFINAL.md's Visual Identity section.
import PixelIcon from './PixelIcon.astro';

const sparklePixels: Array<[number, number]> = [
  [3, 0], [3, 1],
  [0, 3], [1, 3], [3, 3], [5, 3], [6, 3],
  [3, 5], [3, 6],
];

const barsPixels: Array<[number, number]> = [
  [1, 4], [1, 5], [1, 6],
  [3, 2], [3, 3], [3, 4], [3, 5], [3, 6],
  [5, 3], [5, 4], [5, 5], [5, 6],
];

const chipPixels: Array<[number, number]> = [
  [2, 2], [3, 2], [4, 2],
  [2, 3], [3, 3], [4, 3],
  [2, 4], [3, 4], [4, 4],
  [3, 0], [3, 6], [0, 3], [6, 3],
];

const capabilities = [
  {
    title: 'Cleansing & migration',
    body: 'Fixing and moving data so it can actually be trusted downstream.',
    icon: sparklePixels,
  },
  {
    title: 'Warehousing & BI',
    body: 'A single source of truth, and the reporting layer built on it.',
    icon: barsPixels,
  },
  {
    title: 'AI agents & automation',
    body: 'The newest expression of the same full-lifecycle work - never a bolt-on.',
    icon: chipPixels,
  },
];
---

<section class="capabilities" data-reveal>
  <p class="eyebrow">// what I do</p>
  <div class="menu-frame">
    <p class="menu-frame-label">select module</p>
    <div class="menu">
      {
        capabilities.map((c) => (
          <details class="menu-item">
            <summary>
              <span class="selector" aria-hidden="true">
                ▶
              </span>
              <PixelIcon pixels={c.icon} cols={7} rows={7} size={20} />
              <span class="menu-title">{c.title}</span>
            </summary>
            <p class="menu-body">{c.body}</p>
          </details>
        ))
      }
    </div>
  </div>
  <a href="/work" class="see-more">See the work →</a>
</section>

<style>
  .capabilities {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
    border-top: 1px solid var(--border);
  }

  .eyebrow {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--accent-primary);
  }

  .menu-frame {
    border: 1px solid var(--border);
  }

  .menu-frame-label {
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  .menu-item {
    border-bottom: 1px solid var(--border);
  }

  .menu-item:last-child {
    border-bottom: none;
  }

  .menu-item summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    cursor: pointer;
    list-style: none;
  }

  .menu-item summary::-webkit-details-marker {
    display: none;
  }

  .menu-item summary::marker {
    content: '';
  }

  .menu-item summary:hover,
  .menu-item summary:focus-visible {
    background: color-mix(in srgb, var(--text) 4%, transparent);
  }

  .selector {
    color: var(--accent-primary);
    opacity: 0;
    transition: opacity 0.15s ease;
    font-size: 0.75rem;
  }

  .menu-item[open] .selector,
  .menu-item summary:hover .selector,
  .menu-item summary:focus-visible .selector {
    opacity: 1;
  }

  .menu-item :global(.pixel-icon) {
    color: var(--accent-primary);
    flex-shrink: 0;
  }

  .menu-title {
    font-family: var(--font-display);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .menu-body {
    margin: 0;
    padding: 0 var(--space-4) var(--space-4) calc(1.5rem + 20px + var(--space-3) * 2);
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }

  .see-more {
    display: inline-block;
    margin-top: var(--space-6);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--accent-primary);
  }
</style>
