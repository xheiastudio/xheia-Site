---
// "What I do," relocated from Home to /approach as part of the structural redesign —
// grounded in BRANDFINAL §1 "What I do", no invented claims, no past-client language.
// Links to /work for the actual proof.
//
// Copy V2 pass: two new items (Post-acquisition integration / Financial modelling &
// commercial analysis) — the first traces to the life-sciences case study's three
// acquisitions, the second to the fitness case study's pay-structure/board work.
//
// Reworked from a click-to-expand boot-menu (native <details>/<summary>) to an
// auto-loading one: each item now types itself in automatically, staggered one after
// another — icon+title fade in, then a SectionLoader bar fills on its own line below
// the title, then a ✓-prefixed body paragraph lands — same bar-below-title,
// checkmark-before-body layout as PillarBlock's original per-pillar check (this is
// where that visual came from; ported here rather than invented fresh), all keyed off
// this section's own data-reveal .is-visible trigger (see src/styles/global.css), same
// mechanism the site already uses sitewide, no new observer. Being first on the page,
// it plays immediately on load with no scroll needed; the other /approach sections
// play theirs as scrolled into view. Bigger, more dominant sizing throughout (called
// out by name).
//
// Outer frame now matches PillarBlock's exact recipe (inset panel, tinted background,
// generous padding) instead of a plain top-divider + separate inner box - direct
// feedback that Principles' smoothness (one frame, items separated by whitespace, no
// per-item dividers) should be the standard every /approach section matches, not just
// Principles itself. "loading modules..." stays as Capabilities' own distinguishing
// label (its boot-menu personality, per SPEC.md's "distinct interaction per section"
// rule) but without its own sub-box.
import PixelIcon from './PixelIcon.astro';
import SectionLoader from './SectionLoader.astro';
import SectionNumber from './SectionNumber.astro';

const ITEM_STAGGER = 0.35;

const sparklePixels: Array<[number, number]> = [
  [3, 0], [3, 1],
  [0, 3], [1, 3], [3, 3], [5, 3], [6, 3],
  [3, 5], [3, 6],
];

const barsPixels: Array<[number, number]> = [
  [1, 4], [1, 5], [1, 6],
  [3, 2], [3, 3], [3, 4], [3, 5], [3, 6],
  [5, 3], [5, 4], [5, 5], [5, 6],
];

const chipPixels: Array<[number, number]> = [
  [2, 2], [3, 2], [4, 2],
  [2, 3], [3, 3], [4, 3],
  [2, 4], [3, 4], [4, 4],
  [3, 0], [3, 6], [0, 3], [6, 3],
];

// Two converging lines meeting in one stem — multiple things becoming one.
const mergePixels: Array<[number, number]> = [
  [0, 0], [6, 0],
  [1, 1], [5, 1],
  [2, 2], [4, 2],
  [3, 3], [3, 4], [3, 5],
  [2, 6], [3, 6], [4, 6],
];

// A rising step-line with a small flag at the top — distinct from barsPixels' static bars.
const chartPixels: Array<[number, number]> = [
  [0, 6], [1, 6],
  [1, 5], [2, 5],
  [2, 4], [3, 4],
  [3, 3], [4, 3],
  [4, 2], [5, 2],
  [5, 1], [6, 1],
  [5, 0], [6, 0], [6, 2],
];

const capabilities = [
  {
    title: 'Cleansing & migration',
    body: 'Fixing and moving data so it can actually be trusted downstream.',
    icon: sparklePixels,
  },
  {
    title: 'Warehousing & BI',
    body: 'A single source of truth, and the reporting layer built on it.',
    icon: barsPixels,
  },
  {
    title: 'AI agents & automation',
    body: 'The newest expression of the same full-lifecycle work - never a bolt-on.',
    icon: chipPixels,
  },
  {
    title: 'Post-acquisition integration',
    body: 'Consolidating data from multiple systems after a merger or acquisition into one source you can actually act on.',
    icon: mergePixels,
  },
  {
    title: 'Financial modelling & commercial analysis',
    body: 'Financial analysis that stands up in front of a board.',
    icon: chartPixels,
  },
];
---

<section class="capabilities" data-reveal>
  <div class="section-head">
    <SectionNumber number="01" />
    <h2 class="eyebrow">// what I do</h2>
  </div>
  <p class="menu-frame-label">loading modules...</p>
  <div class="menu">
    {
      capabilities.map((c, i) => {
        const delay = i * ITEM_STAGGER;
        return (
          <div class="menu-item">
            <div class="menu-item-head item-content" style={{ transitionDelay: `${delay}s` }}>
              <span class="selector" aria-hidden="true">▶</span>
              <PixelIcon pixels={c.icon} cols={7} rows={7} size={28} />
              <h3 class="menu-title">{c.title}</h3>
            </div>
            <div class="menu-result">
              <SectionLoader delay={delay} />
              <p class="menu-body item-content" style={{ transitionDelay: `${delay + 0.5}s` }}>
                <span class="check-mark" aria-hidden="true">✓</span> {c.body}
              </p>
            </div>
          </div>
        );
      })
    }
  </div>
  <a href="/work" class="see-more">See the work →</a>
</section>

<style>
  /* No border/tinted background - direct feedback overriding the earlier "one frame
     per section" standard: Home's identity is whitespace framing, no borders anywhere
     (the stripped-terminal pass removed Hero's own bezel border for the same reason).
     --space-20 (the widest step on the scale, added for this) is now the only thing
     separating sections, since the box's own padding no longer contributes any
     visual gap - same move as Footer's "divider became whitespace" fix, one level up. */
  .capabilities {
    width: min(100% - 2 * var(--space-4), var(--content-max-width));
    margin: var(--space-20) auto;
    padding: 0;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  /* --accent-primary-text, not --accent-primary: this is real visible text on the
     page background (full audit finding - raw --accent-primary measured 4.22:1
     against Ink in dark mode, below the 4.5:1 minimum). */
  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.875rem;
    line-height: 1.5;
    letter-spacing: 0.06em;
    color: var(--accent-primary-text);
  }

  /* typography.md's macOS translation: 13pt default / 10pt minimum (~17px/~13px).
     This was 0.75rem (12px), under that minimum - same fix already applied to
     Footer's credit line. */
  .menu-frame-label {
    margin: 0 0 var(--space-6);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  .menu {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .menu-item-head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .selector {
    color: var(--accent-primary-text);
    font-size: 0.875rem;
  }

  .menu-item :global(.pixel-icon) {
    color: var(--accent-primary);
    flex-shrink: 0;
  }

  .menu-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .menu-result {
    margin-top: var(--space-3);
    padding-left: calc(1.5rem + 28px + var(--space-4) * 2);
  }

  .menu-body {
    margin: var(--space-3) 0 0;
    color: var(--text-secondary);
    font-size: 1.0625rem;
  }

  .check-mark {
    color: var(--accent-status);
  }

  /* Flare coral (light mode's --accent-status) is 2.04:1 on Paper as text — fails
     WCAG's 4.5:1 minimum (Apple HIG design-review pass). Coral stays for the
     decorative bar fill (not text, no minimum applies the same way); the glyph
     itself switches to --text (Ink, 17:1 on Paper) in light mode only. Dark mode's
     Signal green checkmark (12.9:1) is unaffected. */
  :global(html[data-theme='light']) .check-mark {
    color: var(--text);
  }

  /* --accent-primary-text, not --accent-primary: full audit finding, same as the
     eyebrow above (raw --accent-primary is 4.22:1 against Ink in dark mode, below
     the 4.5:1 text minimum). */
  .see-more {
    display: inline-block;
    margin-top: var(--space-8);
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--accent-primary-text);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    /* Was plain ease - found on a full sweep matching this to the site's
       established cubic-bezier(0.16,1,0.3,1) curve used everywhere else. */
    transition: text-decoration-color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Was opacity: 0.7 - full audit finding: dimming this link's already-adjusted
     text color toward the page background dropped it to 3.13:1 (dark) / 2.95:1
     (light), undoing the fix above for the one state a mouse/keyboard user
     specifically triggers to confirm interactivity. An underline reveal keeps the
     text at full, already-verified contrast in every state. */
  .see-more:hover,
  .see-more:focus-visible {
    text-decoration-color: currentColor;
  }

  .see-more:focus-visible {
    outline: 2px solid var(--accent-primary-text);
    outline-offset: 0.2em;
  }
</style>
