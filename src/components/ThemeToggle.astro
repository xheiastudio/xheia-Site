---
// Dark (default) / light toggle. Keeps document.documentElement's data-theme and
// localStorage['xheia-theme'] in sync with BaseLayout's inline FOUC-prevention script.
// Icons are pixel-art (PixelIcon) rather than line-art SVGs, per the site-wide pixel pass.
import PixelIcon from './PixelIcon.astro';

const sunPixels: Array<[number, number]> = [
  [2, 2], [3, 2], [4, 2], [5, 2],
  [2, 3], [3, 3], [4, 3], [5, 3],
  [2, 4], [3, 4], [4, 4], [5, 4],
  [2, 5], [3, 5], [4, 5], [5, 5],
  [3, 0], [4, 0],
  [3, 7], [4, 7],
  [0, 3], [0, 4],
  [7, 3], [7, 4],
  [1, 1], [6, 1], [1, 6], [6, 6],
];

const moonPixels: Array<[number, number]> = [
  [4, 0], [5, 0],
  [3, 1], [4, 1], [5, 1], [6, 1],
  [3, 2], [6, 2],
  [2, 3], [6, 3],
  [2, 4], [6, 4],
  [3, 5], [6, 5],
  [3, 6], [4, 6], [5, 6], [6, 6],
  [4, 7], [5, 7],
];
---

<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to light mode">
  <PixelIcon class="icon icon-sun" pixels={sunPixels} cols={8} rows={8} size={16} />
  <PixelIcon class="icon icon-moon" pixels={moonPixels} cols={8} rows={8} size={16} />
</button>

<script>
  // Wrapped in astro:page-load (fires on initial load AND after every <ClientRouter />
  // soft navigation) since the button element is recreated on each page swap.
  document.addEventListener('astro:page-load', () => {
    const button = document.getElementById('theme-toggle');

    button?.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      root.setAttribute('data-theme', next);
      localStorage.setItem('xheia-theme', next);
      button.setAttribute(
        'aria-label',
        next === 'light' ? 'Switch to dark mode' : 'Switch to light mode',
      );
    });
  });
</script>

<style>
  .theme-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    border-color: var(--accent-primary);
  }

  /* Same fix already applied to every text link this session - border-color alone
     isn't a visible keyboard-focus indicator. */
  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  /* Both icons stacked and crossfaded (opacity + a slight scale/rotate) instead of a
     hard display:none/block swap - the one remaining instant toggle in the header
     next to everything else's smooth transitions. Absolutely positioned so neither
     one participates in layout while hidden. */
  .icon {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1rem;
    height: 1rem;
    transform: translate(-50%, -50%) scale(0.5) rotate(-90deg);
    opacity: 0;
    transition:
      opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Dark mode (default): show the sun (click to go light). */
  .icon-sun {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1) rotate(0deg);
  }

  /* Light mode: show the moon (click to go dark). */
  :global(html[data-theme='light']) .icon-sun {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.5) rotate(90deg);
  }

  :global(html[data-theme='light']) .icon-moon {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1) rotate(0deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle {
      transition: none;
    }

    .icon {
      transition: none;
      transform: translate(-50%, -50%) scale(1) rotate(0deg);
    }
  }
</style>
