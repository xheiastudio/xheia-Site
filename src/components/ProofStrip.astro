---
// 2-3 condensed CaseStudyCards on Home, linking to /work (SPEC.md — ProofStrip).
import { getCollection } from 'astro:content';
import CaseStudyCard from './CaseStudyCard.astro';

const featured = (await getCollection('caseStudies', ({ data }) => data.featured)).slice(0, 3);
---

<section class="proof-strip">
  <div class="cards">
    {featured.map(({ data }) => <CaseStudyCard {...data} variant="condensed" />)}
  </div>
  <a href="/work" class="see-all">See all work →</a>
</section>

<style>
  .proof-strip {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-4);
  }

  .see-all {
    display: inline-block;
    margin-top: var(--space-6);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--accent-primary);
  }
</style>
