---
// Xheia (mark+wordmark) — Approach — Work — About — Contact — theme toggle —
// one CTA. No dropdowns, no secondary items (SPEC.md — Nav). This is the everyday logo
// lockup, no CRT bezel.
//
// Sticky + scroll-aware (Apple-sleekness pass): was a static header that scrolled
// away with the page - the single most recognizable "premium nav" pattern (apple.com
// included) is a floating header that stays put and picks up a subtle blur/hairline
// only once you've actually scrolled past the top, staying invisible-as-a-box at
// rest. `astro:page-load`-guarded scroll listener (same guard pattern as
// ThemeToggle/PixelCursor) toggles `.is-scrolled`; CSS does the rest with the site's
// established smooth easing.
//
// Full-review pass: the logo gets the same hover/focus glow now on PixelCursor/
// ThemeToggle (it was opacity-fade only - the one interactive "icon" left without
// it). Nav text links are deliberately NOT given this treatment - their existing
// color-shift + drawn-in underline is already a considered, distinct affordance for
// inline text; a box-shadow bloom on bare text reads as a smudge, not a glow.
//
// transition:persist on the logo/ThemeToggle/CTAButton (not the whole header, and
// not <nav>): these three are byte-identical on every page, so persisting them
// avoids an unnecessary remount on every navigation. <nav> is deliberately left
// un-persisted - its `.is-current` state is computed server-side from
// Astro.url.pathname per page, and a persisted element keeps its OLD DOM across a
// swap, which would freeze the current-page underline on whatever page you
// navigated FROM. transition:name is set explicitly (rather than relying on
// Astro's auto-generated name) because CTAButton is rendered more than once on some
// pages (Hero's own CTA on Home, ContactCTA's on /approach and /about) - two
// instances on one page can never share a transition:name, so this one is scoped to
// "header-cta" specifically, set at this call site rather than baked into
// CTAButton.astro itself.
import PixelMark from './PixelMark.astro';
import ThemeToggle from './ThemeToggle.astro';
import CTAButton from './CTAButton.astro';

// Current-page indicator (navigation-structure lens: "current location is always
// visible") - costs nothing to add here and benefits every page once visited, even
// though it renders inert on Home itself (Home has no corresponding nav item - the
// logo is how you get here, not a nav link - so nothing is ever marked current on
// this page specifically, correctly).
const currentPath = Astro.url.pathname;
const navLinks = [
  { href: '/approach', label: 'Approach' },
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-header" id="site-header">
  <div class="site-header-inner">
    <a href="/" class="logo" aria-label="Xheia home" transition:persist transition:name="site-logo">
      <PixelMark size={56} decorative />
      <span class="wordmark">xheia</span>
    </a>

    <nav aria-label="Primary">
      {
        navLinks.map((link) => {
          const isCurrent = currentPath.startsWith(link.href);
          return (
            <a href={link.href} aria-current={isCurrent ? 'page' : undefined} class:list={{ 'is-current': isCurrent }}>
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <div class="actions">
      <ThemeToggle transition:persist transition:name="header-theme-toggle" />
      <CTAButton transition:persist transition:name="header-cta" />
    </div>
  </div>
</header>

<script>
  if (!(window as any).__xheiaHeaderScrollBound) {
    (window as any).__xheiaHeaderScrollBound = true;
    document.addEventListener('astro:page-load', () => {
      const header = document.getElementById('site-header');
      if (!header) return;

      const sync = () => {
        header.classList.toggle('is-scrolled', window.scrollY > 8);
      };
      sync();
      window.addEventListener('scroll', sync, { passive: true });
    });
  }
</script>

<style>
  /* Full-bleed sticky bar (background/blur/border need to span the whole viewport
     width to properly mask content scrolling underneath) with the actual nav row
     centered at --content-max-width inside it, same split every other page uses
     between an outer full-width section and an inner constrained column. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    backdrop-filter: blur(0);
    border-bottom: 1px solid transparent;
    transition:
      background 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      backdrop-filter 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* blur(12px) was below Liquid Glass's own translation table for the "regular"
     variant over text-heavy content (20-40px) - too thin to read as glass, more
     like a faint smudge. Bumped into that range. */
  .site-header.is-scrolled {
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(24px);
    border-bottom-color: var(--border);
  }

  /* accessibility.md's Lens 1 calls this out by name alongside reduced motion:
     "Reduced motion, reduced transparency, and increased contrast all have an
     answer." A blurred, semi-transparent bar over arbitrary scrolled content is
     exactly the kind of translucency this setting exists to opt out of - nav text
     legibility shouldn't depend on what happens to be scrolling underneath it. */
  @media (prefers-reduced-transparency: reduce) {
    .site-header,
    .site-header.is-scrolled {
      background: var(--bg);
      backdrop-filter: none;
    }
  }

  /* Liquid Glass's own review checklist names this directly: "Increase Contrast
     gets stronger fills and borders." Nothing on the site handled this setting at
     all before this pass (grep-confirmed). The header's hairline border and
     translucent fill are exactly the kind of subtle boundary this setting exists
     to reinforce - a solid border and fully opaque background replace the
     translucent glass effect entirely, since "increased contrast" and "blurred
     see-through bar" are in real tension with each other. */
  @media (prefers-contrast: more) {
    .site-header,
    .site-header.is-scrolled {
      background: var(--bg);
      backdrop-filter: none;
      border-bottom-color: var(--border);
    }
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-4);
  }

  /* Found on a genuine full sweep: this is a real link (goes home) that had zero
     hover affordance and no focus ring at all - designing-for-macos.md's "everything
     interactive has pointer feedback, a hover state" and the same focus-ring gap
     already fixed on every other link this session. */
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-2);
    margin: calc(var(--space-1) * -1) calc(var(--space-2) * -1);
    color: var(--text);
    text-decoration: none;
    border-radius: var(--radius);
    box-shadow: 0 0 0 0 transparent;
    transition:
      opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Same soft accent-primary bloom now on PixelCursor/ThemeToggle - the logo was
     the one remaining "icon" left without it. Padding + a matching negative margin
     above keeps the glow from hugging the mark/wordmark too tightly without
     shifting the lockup's own position in the header row. */
  .logo:hover,
  .logo:focus-visible {
    box-shadow: 0 0 1.25rem -0.2rem color-mix(in srgb, var(--accent-primary) 55%, transparent);
  }

  /* Light mode needs a materially bolder glow than the dark-mode value to read as a
     real bloom against Paper (Weber-Fechner - the same percentage shift is obvious
     near black, nearly imperceptible near white) - same finding as every other glow
     on the site, verified rather than guessed. */
  :global(html[data-theme='light']) .logo:hover,
  :global(html[data-theme='light']) .logo:focus-visible {
    box-shadow: 0 0 1.5rem 0 color-mix(in srgb, var(--accent-primary) 85%, transparent);
  }

  .logo:hover {
    opacity: 0.75;
  }

  .logo:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 3px;
  }

  .wordmark {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  nav {
    display: flex;
    gap: var(--space-6);
  }

  nav a {
    position: relative;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    text-decoration: none;
    padding-bottom: 0.25rem;
    border-radius: var(--radius);
    /* Found on a full sweep: color had no transition at all (instant snap) while
       the underline below eased - two halves of one hover state moving at
       different speeds/curves. Both now match the site's established easing. */
    transition: color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--accent-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* --accent-primary-text, not --accent-primary: full audit finding - raw
     --accent-primary as text on the page background is 4.22:1 against Ink in dark
     mode, below the 4.5:1 minimum (tokens.css has the full computation). */
  nav a:hover,
  nav a:focus-visible {
    color: var(--accent-primary-text);
  }

  nav a:hover::after,
  nav a:focus-visible::after {
    transform: scaleX(1);
  }

  /* Navigation-structure lens: "current location is always visible." A persistent
     underline (not just on hover) plus the accent color, keyed off aria-current
     rather than a route-matching class the browser doesn't already know about. */
  nav a.is-current {
    color: var(--accent-primary-text);
  }

  nav a.is-current::after {
    transform: scaleX(1);
  }

  /* Color/underline alone isn't a visible keyboard-focus indicator (accessibility.md
     - WCAG 2.4.7 Focus Visible) - CTAButton already gets a real ring, these links
     didn't. Outline, not the inset box-shadow trick used on the notched CTA button,
     since these have no clip-path corners to protect against. */
  nav a:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 3px;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  /* `order: 3` here (removed) only ever changed visual position - it never touches
     DOM/tab order, which is what keyboard navigation and VoiceOver's rotor
     actually follow. That mismatch sent focus from the logo down to nav (visually
     the *third* row) and then back up to the toggle/CTA (visually the *second*
     row) - a real WCAG 2.4.3 Focus Order violation, found on a full sweep using
     the skill's VoiceOver-navigation lens. Fixed by not reordering at all: nav
     simply wraps to its own full-width row in its natural DOM position (still
     between the logo and actions, same as source order), so visual order and tab
     order are identical at every breakpoint - logo, then nav, then actions, top
     to bottom, matching how it already reads on desktop. */
  @media (max-width: 40rem) {
    .site-header-inner {
      flex-wrap: wrap;
    }

    nav {
      width: 100%;
      justify-content: center;
      gap: var(--space-4);
    }
  }
</style>
