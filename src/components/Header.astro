---
// Xheia (mark+wordmark) — Work — Approach — About — Contact — theme toggle —
// one CTA. No dropdowns, no secondary items (SPEC.md — Nav). This is the everyday logo
// lockup, no CRT bezel.
import PixelMark from './PixelMark.astro';
import ThemeToggle from './ThemeToggle.astro';
import CTAButton from './CTAButton.astro';
---

<header class="site-header">
  <a href="/" class="logo" aria-label="Xheia home">
    <PixelMark size={40} />
    <span class="wordmark">xheia</span>
  </a>

  <nav aria-label="Primary">
    <a href="/work">Work</a>
    <a href="/approach">Approach</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
  </nav>

  <div class="actions">
    <ThemeToggle />
    <CTAButton />
  </div>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-4);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
    text-decoration: none;
  }

  .wordmark {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  nav {
    display: flex;
    gap: var(--space-6);
  }

  nav a {
    position: relative;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-decoration: none;
    padding-bottom: 0.25rem;
  }

  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--accent-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.15s ease;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--accent-primary);
  }

  nav a:hover::after,
  nav a:focus-visible::after {
    transform: scaleX(1);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  @media (max-width: 40rem) {
    .site-header {
      flex-wrap: wrap;
    }

    nav {
      order: 3;
      width: 100%;
      justify-content: center;
      gap: var(--space-4);
    }
  }
</style>
