---
// Three phases, in order: Discovery → Build → Handoff, relocated from Home to
// /approach as part of the structural redesign. Phase descriptions stay tied to
// BRANDFINAL §1's described work (ingestion, cleansing, warehousing, BI) and §5's
// evidence/documentation themes — no new promises invented. Bodies shortened in the
// copy V2 pass.
//
// Redesigned as a level-path — nodes connected by a dashed line, game level-select map
// style — instead of a three-column card row, per the "boxes under boxes" feedback:
// a third distinct interaction/visual (Capabilities = boot-menu, PillarBlock =
// diagnostic self-check, this = level-path), not the same pattern a third time. The
// path metaphor doesn't survive narrow viewports, so mobile falls back to a stacked
// list (see EngagementPhase.astro's own responsive styles).
//
// The section itself is now the one frame (PillarBlock's exact recipe: inset panel,
// tinted background, generous padding) instead of a separate inner `.path-frame` box
// - direct feedback that every /approach section should match Principles' "one frame,
// nothing nested inside it" smoothness. No PixelRivets, no icon - still a distinct
// level-path, just without a redundant second box around it.
//
// Each node fades in staggered one after another as the section scrolls into view
// (see EngagementPhase.astro), via this section's own data-reveal
// (src/styles/global.css) — no SectionLoader bar here, unlike Capabilities/
// PillarBlock: a boot-check bar next to short step labels (Discovery/Build/Handoff)
// read as visual noise rather than a meaningful "load."
import EngagementPhase from './EngagementPhase.astro';
import SectionNumber from './SectionNumber.astro';

const ITEM_STAGGER = 0.35;

const phases = [
  {
    title: 'Discovery',
    body: 'I look at your data and systems, and work out what you actually need.',
  },
  {
    title: 'Build',
    body: 'I clean it up, structure it, and build the reporting or systems on top.',
  },
  {
    title: 'Handoff',
    body: 'You get the finished work, plus documentation clear enough that anyone can pick it up.',
  },
];
---

<section class="engagement-structure" data-reveal>
  <div class="section-head">
    <SectionNumber number="03" />
    <p class="eyebrow">// how I work</p>
  </div>
  <div class="section-content">
    <h2>How an engagement runs</h2>
    <div class="level-path">
      <div class="path-line" aria-hidden="true"></div>
      {
        phases.map((phase, i) => (
          <EngagementPhase order={i + 1} title={phase.title} body={phase.body} delay={i * ITEM_STAGGER} />
        ))
      }
    </div>
  </div>
</section>

<style>
  .engagement-structure {
    width: min(100% - 2 * var(--space-4), var(--content-max-width));
    margin: var(--space-16) auto;
    padding: var(--space-12);
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--text) 3%, transparent);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    color: var(--accent-primary);
  }

  h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.7;
    margin-bottom: var(--space-8);
  }

  .level-path {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .path-line {
    position: absolute;
    z-index: 0;
    top: 2rem;
    left: 16.67%;
    right: 16.67%;
    height: 0;
    border-top: 3px dashed var(--accent-primary);
  }

  @media (max-width: 40rem) {
    .level-path {
      flex-direction: column;
      gap: var(--space-6);
    }

    .path-line {
      display: none;
    }
  }
</style>
