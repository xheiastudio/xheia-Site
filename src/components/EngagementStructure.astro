---
// Three phases, in order: Discovery → Build → Handoff (SPEC.md — EngagementStructure).
// Phase descriptions stay tied to BRANDFINAL §1's described work (ingestion, cleansing,
// warehousing, BI) and §5's evidence/documentation themes — no new promises invented.
import EngagementPhase from './EngagementPhase.astro';
import PixelRivets from './PixelRivets.astro';

const phases = [
  {
    title: 'Discovery',
    body: 'Understand the data, the systems, and what "trustworthy" actually needs to mean here.',
  },
  {
    title: 'Build',
    body: 'Ingestion, cleansing, warehousing, BI — the full-lifecycle work, done in the open.',
  },
  {
    title: 'Handoff',
    body: 'Delivered work, documented plainly — evidence you can check, not just a claim.',
  },
];
---

<section class="engagement-structure" data-reveal>
  <PixelRivets />
  <p class="eyebrow">// how I work</p>
  <h2>How an engagement runs</h2>
  <div class="phases">
    {phases.map((phase, i) => <EngagementPhase order={i + 1} title={phase.title} body={phase.body} />)}
  </div>
</section>

<style>
  .engagement-structure {
    position: relative;
    width: min(100% - 2 * var(--space-4), var(--content-max-width));
    margin: var(--space-8) auto;
    padding: var(--space-8);
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--text) 3%, transparent);
  }

  .eyebrow {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--accent-primary);
  }

  h2 {
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: var(--space-6);
  }

  .phases {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-6);
  }
</style>
