---
// Three phases, in order: Discovery → Build → Handoff (SPEC.md — EngagementStructure).
// Phase descriptions stay tied to BRANDFINAL §1's described work (ingestion, cleansing,
// warehousing, BI) and §5's evidence/documentation themes — no new promises invented.
import EngagementPhase from './EngagementPhase.astro';

const phases = [
  {
    title: 'Discovery',
    body: 'Understand the data, the systems, and what "trustworthy" actually needs to mean here.',
  },
  {
    title: 'Build',
    body: 'Ingestion, cleansing, warehousing, BI — the full-lifecycle work, done in the open.',
  },
  {
    title: 'Handoff',
    body: 'Delivered work, documented plainly — evidence you can check, not just a claim.',
  },
];
---

<section class="engagement-structure">
  <h2>How an engagement runs</h2>
  <div class="phases">
    {phases.map((phase, i) => <EngagementPhase order={i + 1} title={phase.title} body={phase.body} />)}
  </div>
</section>

<style>
  .engagement-structure {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  h2 {
    font-size: 1.25rem;
    margin-bottom: var(--space-6);
  }

  .phases {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-6);
  }
</style>
