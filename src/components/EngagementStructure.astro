---
// Three phases, in order: Discovery → Build → Handoff, relocated from Home to
// /approach as part of the structural redesign. Phase descriptions stay tied to
// BRANDFINAL §1's described work (ingestion, cleansing, warehousing, BI) and §5's
// evidence/documentation themes — no new promises invented. Bodies rewritten in the
// copy pass to first-person, more concrete language (see approach-copy-edits.md) — with
// one correction: the supplied Discovery text named "pharma, public sector, retail, and
// education," but BRANDFINAL.md §1 explicitly says retail/education must not be
// asserted until real detail exists, and "pharma" doesn't match the established "life
// sciences" term used everywhere else. Swapped in the three confirmed sectors instead
// (life sciences, public sector, fitness) — same sentence, same voice, no invented claim.
//
// Redesigned as a level-path — nodes connected by a dashed line, game level-select map
// style — instead of a three-column card row, per the "boxes under boxes" feedback:
// a third distinct interaction/visual (Capabilities = boot-menu, PillarBlock =
// diagnostic self-check, this = level-path), not the same pattern a third time. The
// path metaphor doesn't survive narrow viewports, so mobile falls back to a stacked
// list (see EngagementPhase.astro's own responsive styles).
//
// Deliberately no PixelRivets/bordered-panel shell here — a path is a stretch of open
// ground, not a boxed module. Reusing PillarBlock's bordered-box+rivets container would
// have quietly recreated the exact "boxes under boxes" pattern this redesign exists to
// fix (caught in review). Capabilities' lighter border-top divider is the closer match.
import EngagementPhase from './EngagementPhase.astro';

const phases = [
  {
    title: 'Discovery',
    body: 'First, I get into your data and your systems and work out what "reliable" needs to mean for your business specifically. I\'ve worked across life sciences, public sector, and fitness without knowing the domain going in - so I don\'t assume I already understand your context, I ask until I do.',
  },
  {
    title: 'Build',
    body: 'Ingestion, cleansing, warehousing, BI. You see it get built as it happens, not just a finished dashboard dropped on you at the end.',
  },
  {
    title: 'Handoff',
    body: 'You get the finished work, plus documentation good enough that someone else could pick it up without me in the room. That\'s not a nice-to-have - it\'s what I actually leave behind on every project.',
  },
];
---

<section class="engagement-structure" data-reveal>
  <p class="eyebrow">// how I work</p>
  <h2>How an engagement runs</h2>
  <div class="level-path">
    <div class="path-line" aria-hidden="true"></div>
    {phases.map((phase, i) => <EngagementPhase order={i + 1} title={phase.title} body={phase.body} />)}
  </div>
</section>

<style>
  .engagement-structure {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
    border-top: 1px solid var(--border);
  }

  .eyebrow {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--accent-primary);
  }

  h2 {
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: var(--space-6);
  }

  .level-path {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .path-line {
    position: absolute;
    z-index: 0;
    top: 1rem;
    left: 16.67%;
    right: 16.67%;
    height: 0;
    border-top: 2px dashed var(--border);
  }

  @media (max-width: 40rem) {
    .level-path {
      flex-direction: column;
      gap: var(--space-6);
    }

    .path-line {
      display: none;
    }
  }
</style>
