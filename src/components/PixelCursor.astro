---
// Real, visible pixel-art cursor — replaces the old CSS `cursor:` swap, which was too
// subtle to register as a feature. Tracked via mousemove/transform (cheap, GPU-friendly),
// theme-aware (fill uses --text so it adapts to dark/light automatically), swaps color +
// scales up over interactive elements. Only activates on fine-pointer devices —
// touch/coarse-pointer users keep native behavior untouched, and the native cursor is
// only hidden via a JS-added class, so a JS failure never leaves a dead cursor.
//
// No solid backing plate behind the arrow (dropped after live feedback: a filled
// rect — even at reduced opacity — read as an unwanted dark box trailing the cursor,
// and no other pixel-art element on the site uses a backing plate either).
const arrowPixels: Array<[number, number]> = [
  [0, 0],
  [0, 1], [1, 1],
  [0, 2], [1, 2], [2, 2],
  [0, 3], [1, 3], [2, 3], [3, 3],
  [0, 4], [1, 4], [2, 4], [3, 4], [4, 4],
  [0, 5], [1, 5], [2, 5],
  [0, 6], [2, 6],
  [3, 7],
];
---

<div id="pixel-cursor" class="pixel-cursor" aria-hidden="true" transition:persist>
  <svg viewBox="-1 -1 8 10" width="32" height="40" shape-rendering="crispEdges">
    {arrowPixels.map(([x, y]) => <rect x={x} y={y} width="1" height="1" class="cursor-fill" />)}
  </svg>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const isFinePointer = window.matchMedia('(pointer: fine)').matches;
    const cursor = document.getElementById('pixel-cursor');
    if (!isFinePointer || !cursor) return;

    document.documentElement.classList.add('pixel-cursor-active');
    cursor.style.display = 'block';

    // Guard against double-binding: astro:page-load fires on every soft navigation,
    // but these listeners only need to be attached once for the app's lifetime.
    if ((window as any).__pixelCursorBound) return;
    (window as any).__pixelCursorBound = true;

    document.addEventListener('mousemove', (e) => {
      const el = document.getElementById('pixel-cursor');
      if (el) el.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0)`;
    });

    document.addEventListener('mouseover', (e) => {
      const el = document.getElementById('pixel-cursor');
      if (!el) return;
      const target = e.target as Element | null;
      el.classList.toggle('is-interactive', !!target?.closest('a, button'));
    });
  });
</script>

<style>
  .pixel-cursor {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 10000;
    pointer-events: none;
    will-change: transform;
  }

  .cursor-fill {
    fill: var(--text);
    transition: fill 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pixel-cursor.is-interactive .cursor-fill {
    fill: var(--accent-primary);
  }

  /* This is the one element moving continuously on every page - it had no
     transition at all on its hover scale-up, snapping instantly while every other
     interactive control on the site now eases. Real, findable gap, not a nitpick:
     it's the most-visible-by-volume motion on the whole site. */
  svg {
    transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pixel-cursor.is-interactive svg {
    transform: scale(1.25);
    transform-origin: -4px -4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-fill,
    svg {
      transition: none;
    }
  }

  :global(html.pixel-cursor-active),
  :global(html.pixel-cursor-active *) {
    cursor: none;
  }
</style>
