---
// Condensed variant (ProofStrip on Home) and full variant (/work) — same fields,
// same component (SPEC.md — CaseStudyCard). No dead links: /work/[slug] doesn't
// exist yet, so this renders as a static summary, not a link.
interface Props {
  client: string;
  problem: string;
  approach: string;
  outcome: string;
  tags: string[];
  variant?: 'condensed' | 'full';
}

const { client, problem, approach, outcome, tags, variant = 'condensed' } = Astro.props;
---

<article class:list={['case-study-card', variant]}>
  <p class="client">{client}</p>
  <p class="field">
    <span class="label">Problem</span>
    {problem}
  </p>
  {
    variant === 'full' && (
      <p class="field">
        <span class="label">Approach</span>
        {approach}
      </p>
    )
  }
  <p class="field">
    <span class="label">Outcome</span>
    {outcome}
  </p>
  <ul class="tags">
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
</article>

<style>
  .case-study-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px solid var(--border);
  }

  .client {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text);
  }

  .field {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .label {
    display: block;
    margin-bottom: 0.125rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-primary);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.125rem var(--space-2);
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-secondary);
  }
</style>
