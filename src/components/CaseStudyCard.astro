---
// Always full detail — client/sector, problem, approach, outcome, tags[] (SPEC.md —
// CaseStudyCard). Used only on /work now that Capabilities replaced ProofStrip's
// condensed usage on Home.
//
// Now links to /work/[slug] (Apple HIG design-improvement pass), which presents
// the SAME three fields as a slower, more deliberate "session log" reveal - not
// more content, since none exists beyond these 1-2 sentences per field. Link text
// says "Open the full session log," never "Read more"/"Learn more," so it never
// implies additional material. All three fields stay in full on the card itself -
// each is already one sentence, so a trimmed "preview" would either duplicate the
// full field or cut off mid-thought on a page visitors scan specifically for the
// Outcome.
//
// `featured` (the /work list's first entry) gets a larger Display-font client
// heading - real editorial hierarchy through typography alone.
//
// Rebuilt from a bordered/riveted "card" into a plain editorial list entry
// ("pixelated but Apple" pass, direct feedback that boxes-within-boxes read as
// dense rather than premium regardless of size): no border box, no PixelRivets, no
// hover jitter/scan sweep - just a thin top rule and generous whitespace doing the
// separating. Tags are plain text, not individually bordered pills.
interface Props {
  slug: string;
  client: string;
  problem: string;
  approach: string;
  outcome: string;
  tags: string[];
  featured?: boolean;
}

const { slug, client, problem, approach, outcome, tags, featured = false } = Astro.props;
---

<article class:list={['case-study-entry', { featured }]}>
  <h3 class="client">{client}</h3>
  <p class="field">
    <span class="label">Problem</span>
    {problem}
  </p>
  <p class="field">
    <span class="label">Approach</span>
    {approach}
  </p>
  <p class="field">
    <span class="label">Outcome</span>
    {outcome}
  </p>
  <p class="tags">{tags.join(' · ')}</p>
  <a class="detail-link" href={`/work/${slug}`}>Open the full session log →</a>
</article>

<style>
  /* No border-top divider - full redesign pass, matching the "zero borders
     anywhere" standard already applied to every /approach section. More
     vertical padding (space-8 -> space-12) compensates for the lost visual
     separation, same move as Footer's original "divider became whitespace"
     fix. */
  .case-study-entry {
    padding: var(--space-12) 0;
  }

  .case-study-entry:first-child {
    padding-top: 0;
  }

  .client {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--text);
  }

  /* font-mono, not font-display: full redesign pass - Home's headline is 100%
     IBM Plex Mono, so a pixel-font client name here read as a genuinely
     different typeface. Weight bumped to 700 for the same "featured" presence
     the pixel font carried at this size. */
  .featured .client {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(1.375rem, 3.2vw, 2rem);
    line-height: 1.2;
  }

  .featured .field {
    font-size: 1.0625rem;
  }

  .field {
    margin: 0 0 var(--space-4);
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  /* --accent-primary-text, not --accent-primary (4.22:1 vs Ink in dark mode,
     below 4.5:1); size bumped 11px -> 13px, both the same fixes already
     applied everywhere else this session. */
  .label {
    display: block;
    margin-bottom: var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-primary-text);
  }

  .tags {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .detail-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent-primary-text);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Was opacity: 0.7 - the same bug found and fixed on Capabilities' "See the
     work" link: dimming this already-adjusted text color toward the page
     background drops it back below 4.5:1 on the exact state meant to confirm
     interactivity. Underline reveal keeps full, already-verified contrast in
     every state. */
  .detail-link:hover,
  .detail-link:focus-visible {
    text-decoration-color: currentColor;
  }

  .detail-link:focus-visible {
    outline: 2px solid var(--accent-primary-text);
    outline-offset: 0.2em;
  }
</style>
