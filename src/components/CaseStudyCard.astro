---
// Always full detail — client/sector, problem, approach, outcome, tags[] (SPEC.md —
// CaseStudyCard). Used only on /work now that Capabilities replaced ProofStrip's
// condensed usage on Home.
//
// Now links to /work/[slug] (Apple HIG design-improvement pass), which presents
// the SAME three fields as a slower, more deliberate "session log" reveal - not
// more content, since none exists beyond these 1-2 sentences per field. Link text
// says "Open the full session log," never "Read more"/"Learn more," so it never
// implies additional material. All three fields stay in full on the card itself -
// each is already one sentence, so a trimmed "preview" would either duplicate the
// full field or cut off mid-thought on a page visitors scan specifically for the
// Outcome.
//
// `featured` (the /work list's first entry) gets a larger Display-font client
// heading - real editorial hierarchy through typography alone.
//
// Rebuilt from a bordered/riveted "card" into a plain editorial list entry
// ("pixelated but Apple" pass, direct feedback that boxes-within-boxes read as
// dense rather than premium regardless of size): no border box, no PixelRivets, no
// hover jitter/scan sweep - just a thin top rule and generous whitespace doing the
// separating. Tags are plain text, not individually bordered pills.
interface Props {
  slug: string;
  client: string;
  problem: string;
  approach: string;
  outcome: string;
  tags: string[];
  featured?: boolean;
}

const { slug, client, problem, approach, outcome, tags, featured = false } = Astro.props;
---

<article class:list={['case-study-entry', { featured }]}>
  <h3 class="client">{client}</h3>
  <p class="field">
    <span class="label">Problem</span>
    {problem}
  </p>
  <p class="field">
    <span class="label">Approach</span>
    {approach}
  </p>
  <p class="field">
    <span class="label">Outcome</span>
    {outcome}
  </p>
  <p class="tags">{tags.join(' · ')}</p>
  <a class="detail-link" href={`/work/${slug}`}>Open the full session log →</a>
</article>

<style>
  .case-study-entry {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--border);
  }

  .case-study-entry:first-child {
    border-top: none;
    padding-top: 0;
  }

  .client {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--text);
  }

  .featured .client {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.375rem, 3.2vw, 2rem);
    line-height: 1.6;
  }

  .featured .field {
    font-size: 1.0625rem;
  }

  .field {
    margin: 0 0 var(--space-4);
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .label {
    display: block;
    margin-bottom: var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-primary);
  }

  .tags {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .detail-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent-primary);
    transition: opacity 0.15s ease;
  }

  .detail-link:hover,
  .detail-link:focus-visible {
    opacity: 0.7;
  }

  .detail-link:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 0.2em;
  }
</style>
