---
// Always full detail — client/sector, problem, approach, outcome, tags[] (SPEC.md —
// CaseStudyCard). Used only on /work now that Capabilities replaced ProofStrip's
// condensed usage on Home.
//
// Now links to /work/[slug] (Apple HIG design-improvement pass), which presents
// the SAME three fields as a slower, more deliberate "session log" reveal - not
// more content, since none exists beyond these 1-2 sentences per field. Link text
// says "Open the full session log," never "Read more"/"Learn more," so it never
// implies additional material. All three fields stay in full on the card itself -
// each is already one sentence, so a trimmed "preview" would either duplicate the
// full field or cut off mid-thought on a page visitors scan specifically for the
// Outcome.
import PixelRivets from './PixelRivets.astro';

interface Props {
  slug: string;
  client: string;
  problem: string;
  approach: string;
  outcome: string;
  tags: string[];
}

const { slug, client, problem, approach, outcome, tags } = Astro.props;
---

<article class="case-study-card pixel-jitter-hover">
  <PixelRivets inset="0.3rem" />
  <h3 class="client">{client}</h3>
  <p class="field">
    <span class="label">Problem</span>
    {problem}
  </p>
  <p class="field">
    <span class="label">Approach</span>
    {approach}
  </p>
  <p class="field">
    <span class="label">Outcome</span>
    {outcome}
  </p>
  <ul class="tags">
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
  <a class="detail-link" href={`/work/${slug}`}>Open the full session log →</a>
</article>

<style>
  .case-study-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px solid var(--border);
    transition: border-color 0.15s ease;
  }

  .case-study-card:hover {
    border-color: var(--accent-primary);
    animation: pixel-jitter 0.3s steps(4);
  }

  /* A diagnostic-scan sweep on hover, reinforcing the same "boot check" metaphor
     used elsewhere on the site (Apple HIG design-improvement pass) - additive to
     the border-color/jitter hover above, not a replacement. */
  .case-study-card::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 2px;
    background: var(--accent-primary);
    opacity: 0;
    pointer-events: none;
  }

  .case-study-card:hover::after {
    animation: card-scan-sweep 0.6s ease-in-out;
  }

  @keyframes card-scan-sweep {
    0% {
      top: 0;
      opacity: 1;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-study-card:hover::after {
      animation: none;
    }
  }

  .client {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--text);
  }

  .field {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .label {
    display: block;
    margin-bottom: 0.125rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-primary);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.125rem var(--space-2);
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-secondary);
  }

  .detail-link {
    display: inline-block;
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent-primary);
    transition: opacity 0.15s ease;
  }

  .detail-link:hover,
  .detail-link:focus-visible {
    opacity: 0.7;
  }

  .detail-link:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 0.2em;
  }
</style>
