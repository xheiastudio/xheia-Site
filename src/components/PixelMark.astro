---
// Pixel-art eye sprite, per BRANDFINAL.md §4 — blocky outline with a five-block pupil.
// Outline swaps Signal green (dark) <-> Ink (light) via --mark-outline; pupil is always
// Aperture blue via --mark-pupil. See src/styles/tokens.css.
interface Props {
  size?: number;
  // Set true when an ancestor already carries the accessible name (e.g. Header's
  // logo link has its own aria-label="Xheia home") - otherwise this mark's own
  // role="img"/aria-label nests a second accessible name inside the first, which
  // some assistive tech exposes as a redundant extra stop (found on a full sweep,
  // via accessibility.md's Lens 1). Footer's static (non-link) usage and the Hero
  // watermark (already aria-hidden via its own wrapper) are unaffected either way.
  decorative?: boolean;
}

const { size = 28, decorative = false } = Astro.props;

// 11x7 pixel grid: a hollow diamond/lens outline with a plus-shaped five-block pupil.
const outline: Array<[number, number]> = [
  [3, 0], [4, 0], [5, 0], [6, 0], [7, 0],
  [2, 1], [8, 1],
  [1, 2], [9, 2],
  [0, 3], [10, 3],
  [1, 4], [9, 4],
  [2, 5], [8, 5],
  [3, 6], [4, 6], [5, 6], [6, 6], [7, 6],
];

const pupil: Array<[number, number]> = [
  [5, 2],
  [4, 3], [5, 3], [6, 3],
  [5, 4],
];
---

<svg
  class="pixel-mark"
  viewBox="0 0 11 7"
  width={size}
  height={(size * 7) / 11}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : 'Xheia'}
  aria-hidden={decorative ? 'true' : undefined}
>
  {outline.map(([x, y]) => <rect class="outline" x={x} y={y} width="1" height="1" />)}
  <g class="pupil-group">
    {pupil.map(([x, y]) => <rect class="pupil" x={x} y={y} width="1" height="1" />)}
  </g>
</svg>

<style>
  .pixel-mark {
    shape-rendering: crispEdges;
    display: block;
  }

  .outline {
    fill: var(--mark-outline);
  }

  .pupil {
    fill: var(--mark-pupil);
  }

  /* Idle blink — the mark stays "alive" rather than static, part of the site-wide
     pixel/retro pass. The original 6s cycle with a ~2%-of-cycle closed-eye window was
     too subtle to register as "blinking" at a glance (live feedback) — same failure
     mode the old CSS-only pixel cursor had before it became a real visible element.
     Shorter cycle, wider closed-eye window: still brief per-blink, but perceptible. */
  .pupil-group {
    animation: pixelmark-blink 3s steps(1) infinite;
  }

  @keyframes pixelmark-blink {
    0%,
    92%,
    100% {
      opacity: 1;
    }
    94%,
    98% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pupil-group {
      animation: none;
    }
  }
</style>
