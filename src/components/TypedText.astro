---
// Declarative wrapper around src/scripts/typewriter.ts for text/timing known at
// build time (404, case-study detail pages). Renders the real text server-side so
// a no-JS or pre-JS visitor always sees the actual sentence immediately; the
// script only clears and retypes it once motion isn't reduced. Runtime-only
// consumers (Contact's confirmation, About's post-image-load reveal) call
// typeText()/typeSequence() directly instead of using this component.
interface Props {
  text: string;
  as?: 'span' | 'p' | 'h1' | 'h2' | 'h3';
  /** seconds before this instance starts typing */
  delay?: number;
  /** characters per second */
  cps?: number;
  /** leave the blinking cursor in place once typing finishes, instead of removing it */
  keepCursor?: boolean;
}

const { text, as: Tag = 'span', delay = 0, cps, keepCursor = false }: Props = Astro.props;
---

<Tag
  class="type-target"
  data-type-text={text}
  data-type-delay={delay}
  data-type-cps={cps ?? ''}
  data-type-keep-cursor={keepCursor ? 'true' : undefined}
>{text}</Tag>

<script>
  import { typeText } from '../scripts/typewriter';

  document.addEventListener('astro:page-load', () => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLElement>('[data-type-text]').forEach((el) => {
      const text = el.dataset.typeText ?? '';
      if (reduced) {
        // Already the real server-rendered text — nothing to do, and no reason to
        // impose the staggered delay below when motion (and the sense of "wait")
        // is meant to be minimized, not just un-animated.
        return;
      }
      const cps = el.dataset.typeCps ? Number(el.dataset.typeCps) : undefined;
      const delayMs = Number(el.dataset.typeDelay ?? 0) * 1000;
      const keepCursorOnDone = el.dataset.typeKeepCursor === 'true';
      // Clear immediately (not just once the delay above elapses) so a staggered
      // later field never flashes its full real text before being wiped and
      // retyped — only this element's own delay controls when typing *starts*.
      el.textContent = '';
      setTimeout(() => typeText(el, text, { cps, keepCursorOnDone }), delayMs);
    });
  });
</script>
