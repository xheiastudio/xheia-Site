---
// Solid pixel-art retro computer monitor. Same coordinate-array-to-SVG-rects technique
// as PixelMark.astro, deliberately reused: a hollow outline trace or a CSS-bordered card
// both read as "a box," not a device, across several rounds of direct feedback — solid
// filled blocks are what actually reads as pixel-art hardware (the eye mark already
// proves this). See Hero.astro's frontmatter for why this exists alongside the earlier
// "no CRT chrome" decision rather than reversing it outright — this is a smaller,
// self-contained device graphic for the boot preamble specifically, not the retired
// border/scanline/window-chrome treatment.
//
// Round three (direct feedback): three changes at once, all aimed at the same
// complaint - "not retro enough" / "awkward gap." (1) The stand didn't read well and is
// gone - just the monitor now. (2) A single-tone thin bezel was flat, not retro; it's
// now a layered two-tone bezel (an outer casing ring, then a lighter inner trim ring,
// then the screen) - the classic "chunky plastic frame with a raised inner trim" look
// old CRT monitors actually had, built with plain nested rects, no gradients. (3) The
// viewBox went from a wide 16:11 to a boxier 14:12, closer to a real CRT's ~4:3 -
// previously the screen was wide enough that short boot-preamble lines (nowrap, well
// under the screen's own width) left a visibly lopsided gap on the right; a narrower
// screen both looks more like a period-correct monitor and leaves much less dead space
// next to short lines.
//
// Unlike PixelMark (purely decorative in every usage), this component hosts real content:
// the default slot is positioned over the screen rect's own viewBox-relative bounds, so
// whatever's passed in (boot-log text) renders as real DOM text on top of the SVG, not
// baked into it. The SVG itself is aria-hidden — it's chrome around that real content.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const viewW = 14;
const viewH = 12;

// Outermost casing, full extent.
const casing = { x: 0, y: 0, width: 14, height: 12 };
// Inner trim ring, inset 1 unit - a lighter tone than the casing, giving the bezel its
// two-tone "raised inner frame" read instead of one flat border.
const trim = { x: 1, y: 1, width: 12, height: 10 };
// Screen, inset another 1 unit from the trim.
const screen = { x: 2, y: 2, width: 10, height: 8 };

const screenRect = {
  left: `${(screen.x / viewW) * 100}%`,
  top: `${(screen.y / viewH) * 100}%`,
  width: `${(screen.width / viewW) * 100}%`,
  height: `${(screen.height / viewH) * 100}%`,
};
---

<div class:list={['pixel-computer', className]}>
  <svg
    class="pixel-computer-svg"
    viewBox={`0 0 ${viewW} ${viewH}`}
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <rect class="casing" x={casing.x} y={casing.y} width={casing.width} height={casing.height} />
    <rect class="trim" x={trim.x} y={trim.y} width={trim.width} height={trim.height} />
    <rect class="screen-bg" x={screen.x} y={screen.y} width={screen.width} height={screen.height} />
  </svg>
  <div class="pixel-computer-screen" style={screenRect}>
    <slot />
  </div>
</div>

<style>
  .pixel-computer {
    position: relative;
    width: 100%;
    aspect-ratio: 14 / 12;
  }

  .pixel-computer-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    shape-rendering: crispEdges;
    filter: drop-shadow(
      0 0.6rem 1.5rem color-mix(in srgb, var(--accent-status) 45%, transparent)
    );
  }

  /* Muted tint of the mark token, not a full-saturation fill — checked by rendering
     this: 45% read as a solid block of near-full Signal green in dark mode, dominating
     the section instead of reading as "device material." */
  .casing {
    fill: color-mix(in srgb, var(--mark-outline) 14%, var(--bg));
  }

  /* Lighter than the casing - the "raised trim ring" that gives the bezel its retro,
     layered read instead of one flat-toned border. */
  .trim {
    fill: color-mix(in srgb, var(--mark-outline) 30%, var(--bg));
  }

  /* A tint of --bg, not a hardcoded dark primitive — themes naturally with the rest of
     the page instead of forcing a permanently-dark "CRT screen" regardless of mode. This
     also means the boot-log text sitting on it can keep its already-audited
     --text-secondary/--accent-primary-text colors with no screen-specific overrides. */
  .screen-bg {
    fill: color-mix(in srgb, var(--accent-status) 12%, var(--bg));
  }

  /* overflow: visible, not hidden - the operator-response line's length varies with
     real copy and real font metrics, and clipping it if it ever runs a touch taller
     than the screen rect would silently cut off real content. Any small overrun just
     extends slightly past the screen tint into the trim ring rather than losing text. */
  .pixel-computer-screen {
    position: absolute;
    overflow: visible;
    padding: 6% 7%;
  }
</style>
