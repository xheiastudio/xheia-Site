---
// New page per SPEC.md's structural-redesign revision note: "what I do" (Capabilities),
// "principles" (PillarBlock), and "how I work" (EngagementStructure) used to be stacked
// on Home as three look-alike boxes — moved here as one coherent page instead, each
// section keeping its own distinct interaction (boot-menu / diagnostic-check /
// level-path) rather than repeating the same card pattern three times.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Capabilities from '../../components/Capabilities.astro';
import PillarBlock from '../../components/PillarBlock.astro';
import EngagementStructure from '../../components/EngagementStructure.astro';
import Tools from '../../components/Tools.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Approach" description="What I do, how I think about it, and how a project runs from first call to handover.">
  <Header />
  <main class="approach-page" id="main-content">
    <h1 class="intro">
      What I do, how I think about it, and how a project runs from first call to
      handover.
    </h1>
    <Capabilities />
    <PillarBlock />
    <EngagementStructure />
    <Tools />
  </main>
  <ContactCTA />
  <Footer />
</BaseLayout>

<style>
  .approach-page {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) 0;
  }

  /* This h1 was styled to look exactly like a body paragraph (font-body, 17px,
     --text-secondary) - a deliberate choice from an earlier accessibility pass,
     whose only goal was promoting a <p> to a real heading without changing its
     appearance. That's correct for accessibility, but it leaves this page with no
     visible hierarchy at all: Home's headline is now the page's one commanding
     statement, and this page's own top heading reads as identical-weight body
     text. Given real presence - mono (matching every h2/h3 on this page and
     Home's own headline register), heavier weight, larger size, full --text
     color - without going as big as Home's hero headline, since this is a content
     page introducing four dense sections below it, not a single-focus landing
     moment. */
  .intro {
    max-width: 34rem;
    margin: 0 0 var(--space-8);
    color: var(--text);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(1.5rem, 1.8vw + 1.1rem, 1.875rem);
    line-height: 1.4;
  }
</style>
