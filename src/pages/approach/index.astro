---
// New page per SPEC.md's structural-redesign revision note: "what I do" (Capabilities),
// "principles" (PillarBlock), and "how I work" (EngagementStructure) used to be stacked
// on Home as three look-alike boxes — moved here as one coherent page instead, each
// section keeping its own distinct interaction (boot-menu / diagnostic-check /
// level-path) rather than repeating the same card pattern three times.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import PageIntroAtmosphere from '../../components/PageIntroAtmosphere.astro';
import Capabilities from '../../components/Capabilities.astro';
import PillarBlock from '../../components/PillarBlock.astro';
import EngagementStructure from '../../components/EngagementStructure.astro';
import Tools from '../../components/Tools.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Approach" description="What I do, how I think about it, and how a project runs from first call to handover.">
  <Header />
  <main id="main-content">
    <PageIntroAtmosphere>
      <h1 class="intro">
        What I do, how I think about it, and how a project runs from first call to
        handover.
      </h1>
    </PageIntroAtmosphere>
    <div class="approach-page">
      <Capabilities />
      <PillarBlock />
      <EngagementStructure />
      <Tools />
    </div>
  </main>
  <ContactCTA />
  <Footer />
</BaseLayout>

<style>
  /* Only the content BELOW the intro is width-constrained here - the intro itself
     (PageIntroAtmosphere) is now full-bleed, matching Hero's actual structure
     (Home/index.astro's <main> has no width constraint at all; Hero's own .bezel
     self-constrains internally). Full-redesign-pass finding: with this class
     wrapping everything, the glow/mark were boxed inside the 1152px content
     column with visible flat margins at wide viewports, while Home's genuinely
     reaches the screen edges - a real, visible "different background" difference,
     not just a matter of matching intensity. */
  .approach-page {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) 0;
  }

  /* Exact match to Home's headline (.headline, Hero.astro) - same font, weight,
     clamp, line-height, letter-spacing. Direct feedback that a "sibling, not a
     match" (previously a smaller clamp/lighter weight) still read as visually
     different pages; this removes that gap entirely rather than narrowing it. */
  .intro {
    max-width: 46rem;
    margin: 0;
    color: var(--text);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(2.25rem, 3.4vw + 1.1rem, 3.75rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
</style>
