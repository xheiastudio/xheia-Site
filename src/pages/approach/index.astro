---
// New page per SPEC.md's structural-redesign revision note: "what I do" (Capabilities),
// "principles" (PillarBlock), and "how I work" (EngagementStructure) used to be stacked
// on Home as three look-alike boxes — moved here as one coherent page instead, each
// section keeping its own distinct interaction (boot-menu / diagnostic-check /
// level-path) rather than repeating the same card pattern three times.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import PageIntroAtmosphere from '../../components/PageIntroAtmosphere.astro';
import Capabilities from '../../components/Capabilities.astro';
import PillarBlock from '../../components/PillarBlock.astro';
import EngagementStructure from '../../components/EngagementStructure.astro';
import Tools from '../../components/Tools.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Approach" description="What I do, how I think about it, and how a project runs from first call to handover.">
  <Header />
  <main class="approach-page" id="main-content">
    <PageIntroAtmosphere>
      <h1 class="intro">
        What I do, how I think about it, and how a project runs from first call to
        handover.
      </h1>
    </PageIntroAtmosphere>
    <Capabilities />
    <PillarBlock />
    <EngagementStructure />
    <Tools />
  </main>
  <ContactCTA />
  <Footer />
</BaseLayout>

<style>
  .approach-page {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) 0;
  }

  .approach-page :global(.intro-atmosphere) {
    padding: var(--space-8) 0 var(--space-6);
  }

  /* Real headline presence - mono (matching every h2/h3 on this page and Home's own
     headline register), a confident size/weight jump from the previous body-adjacent
     styling, sitting inside PageIntroAtmosphere's glow the way Home's headline sits
     inside Hero's. Deliberately short of Home's own clamp(2.25rem,3.4vw+1.1rem,3.75rem)
     - a real sibling, not a match, since this page introduces four sections below it
     rather than being a single-focus landing moment. */
  .intro {
    max-width: 38rem;
    margin: 0 0 var(--space-2);
    color: var(--text);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: clamp(1.875rem, 2.6vw + 1.1rem, 3rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
</style>
