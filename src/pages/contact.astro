---
// Header, ContactForm, mailto fallback, Footer (SPEC.md — Pages & routes /contact).
//
// Contact-page-revamp pass (direct feedback + research into how solo/boutique
// consultancy sites structure this page - "clarity over cleverness," one clear
// path, minimal surrounding decoration): three changes, reversing several of
// this file's own earlier decisions.
//
// (1) Book a call is now the page's PRIMARY action, not a small plain-text
// line under the form. This reverses the booking-link-and-pricing-page pass's
// explicit "not a second CTAButton style or a competing CTA" call - a
// deliberate override, at direct request, now that Book a call has moved from
// "an extra option next to the form" to "the thing most visitors here should
// actually do" (this page's own target personas skip a form round-trip for a
// scoped call, per that same pass's rationale for adding the link at all).
// It's still NOT literally <CTAButton /> and doesn't reuse that label/
// destination - a one-off, page-specific button (.book-call below) styled
// with the same materials (pixel-notch, accent-primary fill, hover glow) so
// it reads as a first-class action rather than a new invented style, without
// making CTAButton itself a two-destination component. CTAButton stays the
// only *reusable* CTA on the site, still "Start a conversation" -> /contact
// everywhere else - this page is the one place that destination is already
// where the visitor is, so the slot it usually fills is free for this instead.
//
// (2) The "$ next / 01 02 03" steps list is cut entirely - direct feedback
// that it read as filler explaining something visitors don't need explained,
// not real information. The "$ connection: ready" status line stays (a small,
// single-line brand touch, not a competing block of content).
//
// (3) The two-column grid (intro text beside the form, each in its own
// visual "box") is dropped for one centered column, top to bottom - matches
// the single-clear-path pattern research on solo-consultant contact pages
// converges on, and removes the boxed-panel feeling entirely rather than
// re-skinning it.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageIntroAtmosphere from '../components/PageIntroAtmosphere.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';

const BOOKING_URL = 'https://calendar.app.google/DdsSsKTNJierjQu89';
---

<BaseLayout title="Contact" description="Start a conversation.">
  <Header />
  <main id="main-content">
    <PageIntroAtmosphere>
      <h1 class="intro">Start a conversation</h1>
    </PageIntroAtmosphere>
    <div class="contact-page">
      <div class="contact-lead" data-reveal>
        <p class="lead-text item-content" style={{ transitionDelay: '0s' }}>
          Tell me what you're trying to solve.
        </p>
        <p class="status-line item-content" style={{ transitionDelay: '0.1s' }}>
          <span class="status-dot" aria-hidden="true"></span>
          $ connection: ready
        </p>

        <div class="primary-action item-content" style={{ transitionDelay: '0.2s' }}>
          <a
            href={BOOKING_URL}
            class="book-call pixel-notch"
            target="_blank"
            rel="noopener noreferrer"
          >
            Book a call <span aria-hidden="true">&rarr;</span>
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
          <p class="book-call-caption">30 minutes, no pitch - just figuring out if it's a fit.</p>
        </div>

        <p class="divider item-content" style={{ transitionDelay: '0.3s' }}>
          <span>or write in</span>
        </p>
      </div>

      <ContactForm />
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Only the content BELOW the intro is width-constrained - the intro itself
     (PageIntroAtmosphere) is full-bleed, matching every other page. Narrower
     than the old two-column grid's 64rem - one focused column, not a wide
     spread, per the "drop the boxes" pass above. */
  .contact-page {
    max-width: 34rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-16);
  }

  /* Exact match to Home's headline (.headline, Hero.astro) - same font,
     weight, clamp, line-height, letter-spacing, same fix already proven on
     every other page. */
  .intro {
    max-width: 46rem;
    margin: 0;
    color: var(--text);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(2.25rem, 3.4vw + 1.1rem, 3.75rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Smooth, coordinated entrance - hero-moment page, not a data grid (CLAUDE.md's
     two-tier motion rule), matching About/Contact's own established convention.
     Higher specificity than the sitewide [data-reveal]/.item-content rules in
     global.css (steps() timing), so this overrides them without touching that
     shared file. */
  .contact-lead[data-reveal] {
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-lead[data-reveal] .item-content {
    transform: translateY(0.9rem);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-lead[data-reveal].is-visible .item-content {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-lead[data-reveal] .item-content {
      transform: none;
      transition: none;
    }
  }

  .lead-text {
    margin: 0;
    color: var(--text);
    font-size: 1.1875rem;
    line-height: 1.5;
  }

  .status-line {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent-status);
    animation: contact-status-pulse 2s ease-in-out infinite;
  }

  /* Light mode's coral is noticeably flatter than dark mode's glowing signal green -
     a small halo gives it the same "alive" quality dark mode gets for free from the
     color itself. */
  :global(html[data-theme='light']) .status-dot {
    box-shadow: 0 0 0.5rem 0.05rem color-mix(in srgb, var(--accent-status) 70%, transparent);
  }

  @keyframes contact-status-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot {
      animation: none;
    }
  }

  .primary-action {
    margin-top: var(--space-8);
  }

  /* Same materials as CTAButton (pixel-notch, accent-primary fill, the site's
     established glow-on-hover recipe) but deliberately bigger - this is the
     page's actual centerpiece action, not a nav-level CTA. Not the shared
     component itself - see the top comment block for why. */
  .book-call {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: var(--space-4) var(--space-8);
    border: 1px solid var(--accent-primary-fill);
    border-radius: var(--radius);
    background: var(--accent-primary-fill);
    color: var(--on-accent-primary);
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 0 0 0 transparent;
    transition:
      background-color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .book-call:active {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    .book-call:active {
      transform: none;
    }
  }

  /* Text-on-transparent (revealing the page background) - same scenario
     --accent-primary-text exists for (raw --accent-primary is 4.22:1 against
     Ink in dark mode, below the 4.5:1 text minimum). */
  .book-call:hover,
  .book-call:focus-visible {
    background: transparent;
    color: var(--accent-primary-text);
    box-shadow: 0 0 1.5rem -0.2rem color-mix(in srgb, var(--accent-primary) 55%, transparent);
  }

  /* Light mode needs a materially bolder glow than the dark-mode value to read
     as a real bloom against Paper (Weber-Fechner) - same finding as every
     other glow on the site, verified rather than guessed. */
  :global(html[data-theme='light']) .book-call:hover,
  :global(html[data-theme='light']) .book-call:focus-visible {
    box-shadow: 0 0 1.75rem 0 color-mix(in srgb, var(--accent-primary) 85%, transparent);
  }

  /* clip-path (.pixel-notch) cuts two corners off the box, so an outward
     `outline` would get clipped away right where it's cut - inset ring
     instead, matching CTAButton's identical fix. */
  .book-call:focus-visible {
    outline: none;
    box-shadow:
      inset 0 0 0 2px var(--accent-primary-text),
      0 0 1.5rem -0.2rem color-mix(in srgb, var(--accent-primary) 55%, transparent);
  }

  :global(html[data-theme='light']) .book-call:focus-visible {
    box-shadow:
      inset 0 0 0 2px var(--accent-primary-text),
      0 0 1.75rem 0 color-mix(in srgb, var(--accent-primary) 85%, transparent);
  }

  .book-call-caption {
    margin: var(--space-3) 0 0;
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }

  /* Small text divider, not a rule/border - "no boxes" extends to not drawing
     a literal line across the column either. Bottom margin, not just top -
     without it the form's first label sits right under this line with no
     breathing room, reading as cramped against the rest of the page's
     generous spacing. */
  .divider {
    margin: var(--space-8) 0 var(--space-4);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
</style>
