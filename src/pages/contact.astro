---
// Header, ContactForm, mailto fallback, Footer (SPEC.md — Pages & routes /contact).
// Two-column layout on wide screens (heading + short context on the left, the form
// on the right) instead of a single narrow stacked column - a considered contact
// page instead of a bare heading-over-form (Apple HIG design-improvement pass,
// "bolder structurally" round). Stacks back to one column under 45rem.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Contact" description="Start a conversation.">
  <Header />
  <main class="contact-page" id="main-content">
    <div class="contact-grid">
      <div class="contact-intro">
        <h1>Start a conversation</h1>
        <p class="intro-text">
          Tell me what you're trying to solve - I'll get back to you within a couple
          of business days.
        </p>
      </div>
      <ContactForm />
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .contact-page {
    max-width: 64rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-16);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: var(--space-12);
    align-items: start;
  }

  .contact-intro h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.5;
    margin: 0 0 var(--space-4);
  }

  .intro-text {
    margin: 0;
    color: var(--text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  @media (max-width: 45rem) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
