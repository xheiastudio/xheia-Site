---
// Header, ContactForm, mailto fallback, Footer (SPEC.md — Pages & routes /contact).
// Two-column layout on wide screens (heading + short context on the left, the form
// on the right) instead of a single narrow stacked column - a considered contact
// page instead of a bare heading-over-form (Apple HIG design-improvement pass,
// "bolder structurally" round). Stacks back to one column under 45rem.
//
// Connection-status line reuses Footer's/About's exact pulsing-dot "$ ..." device -
// a small terminal-flavored touch signaling the channel is open, right where someone
// is about to use it.
//
// Smoothness pass (explicit request - "drastic, no small changes," matching the
// treatment already applied to About): the intro column previously appeared
// instantly on load with zero motion, the most static thing on the page. It now
// gets the same warm, fluid entrance as About's story section - real deceleration
// easing (cubic-bezier(0.16,1,0.3,1)), not the sitewide steps() convention used on
// data-grid sections - staggered across the heading, intro copy, and status line.
// The form itself (ContactForm.astro) got the matching treatment plus a fully
// reworked success/error transition - see that file's own comment block.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageIntroAtmosphere from '../components/PageIntroAtmosphere.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Contact" description="Start a conversation.">
  <Header />
  <main id="main-content">
    <PageIntroAtmosphere>
      <h1 class="intro">Start a conversation</h1>
    </PageIntroAtmosphere>
    <div class="contact-page">
      <div class="contact-grid">
        <div class="contact-intro" data-reveal>
          <p class="intro-text item-content" style={{ transitionDelay: '0s' }}>
            Tell me what you're trying to solve - I'll get back to you within a couple
            of business days.
          </p>
          <p class="status-line item-content" style={{ transitionDelay: '0.15s' }}>
            <span class="status-dot" aria-hidden="true"></span>
            $ connection: ready
          </p>
        </div>
        <ContactForm />
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Only the content BELOW the intro is width-constrained - the intro itself
     (PageIntroAtmosphere) is full-bleed, matching Home's actual structure and
     the same fix already applied to /approach, /work, and /about. */
  .contact-page {
    max-width: 64rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-16);
  }

  /* Exact match to Home's headline (.headline, Hero.astro) - same font,
     weight, clamp, line-height, letter-spacing, same fix already proven on
     every other page. Was font-display (Press Start 2P) capped at
     clamp(1.5rem,3vw,1.75rem) specifically because it used to live in a
     narrow grid column next to the form - now full-width above the grid, so
     it can take the same scale as everywhere else without overflowing
     anything. */
  .intro {
    max-width: 46rem;
    margin: 0;
    color: var(--text);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(2.25rem, 3.4vw + 1.1rem, 3.75rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: var(--space-12);
    align-items: start;
  }

  /* Smooth, coordinated entrance - see the top comment block. Higher specificity
     than the sitewide [data-reveal]/.item-content rules in global.css (steps()
     timing), so this overrides them without touching that shared file. */
  .contact-intro[data-reveal] {
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-intro[data-reveal] .item-content {
    transform: translateY(0.9rem);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-intro[data-reveal].is-visible .item-content {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-intro[data-reveal] .item-content {
      transform: none;
      transition: none;
    }
  }

  .intro-text {
    margin: 0;
    color: var(--text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .status-line {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent-status);
    animation: contact-status-pulse 2s ease-in-out infinite;
  }

  @keyframes contact-status-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot {
      animation: none;
    }
  }

  @media (max-width: 45rem) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
