---
// Header, intro line, grid of full CaseStudyCards, Footer (SPEC.md — Pages & routes /work).
// Intro line (copy pass) leads with sector breadth instead of repeating Home's
// lifecycle phrasing verbatim — no new claims invented, ties into the sectors strip
// directly below it. A small "more case studies loading" note (copy pass) sits below
// the real grid, reusing the existing .pending-caret blink already defined for the
// empty-state branch below — same visual language, lighter treatment (no bordered box,
// that's reserved for the true empty state).
//
// Handles two states so real case studies can be dropped into
// src/content/case-studies/ later with no further code changes: empty (now — an honest
// in-progress message, no fabricated content) and populated (an anonymization
// disclaimer above the grid, since entries name sector/scope, never clients).
//
// Renamed from "Track Record" (see SPEC.md revision note) — the compass_artifact
// research doc flags that label as priming a resume reading for a services buyer.
// Sectors strip is derived from each case study's tags (sector is always the last
// tag by convention — see src/content/case-studies/*.md) rather than hardcoded, so
// it stays in sync automatically as entries are added or removed.
import { getCollection } from 'astro:content';
import { caseStudySlug } from '../../content.config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import PixelRivets from '../../components/PixelRivets.astro';

const caseStudies = await getCollection('caseStudies');

const sectors = [...new Set(caseStudies.map((cs) => cs.data.tags.at(-1)))].map(
  (sector) => sector!.replace(/^./, (c) => c.toUpperCase()),
);
---

<BaseLayout title="Work" description="Full-lifecycle data work, delivered.">
  <Header />
  <main class="work-page" id="main-content">
    <h1 class="intro">
      Real engagements across life sciences, public sector, and fitness - different
      sectors, same underlying problem to solve.
    </h1>
    {
      sectors.length > 0 && (
        <h2 class="eyebrow">
          // sectors <span class="sectors">{sectors.join(' · ')}</span>
        </h2>
      )
    }
    {
      caseStudies.length === 0 ? (
        <p class="pending">
          <PixelRivets inset="0.3rem" />
          Case studies are added here as real engagements are finalized for
          publication.<span class="pending-caret" aria-hidden="true"></span>
        </p>
      ) : (
        <>
          <p class="disclaimer">
            Client details are withheld by agreement; the work and outcomes below are
            real.
          </p>
          <div class="grid">
            {caseStudies.map(({ id, data }) => <CaseStudyCard slug={caseStudySlug(id)} {...data} />)}
          </div>
          <p class="loading-more">
            More case studies loading<span class="pending-caret" aria-hidden="true"></span>
          </p>
        </>
      )
    }
  </main>
  <Footer />
</BaseLayout>

<style>
  .work-page {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-16);
  }

  .intro {
    max-width: 32rem;
    margin: 0 0 var(--space-8);
    color: var(--text-secondary);
    font-size: 1.0625rem;
    font-family: var(--font-body);
    font-weight: 400;
    line-height: 1.5;
  }

  .eyebrow {
    margin: 0 0 var(--space-6);
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.75rem;
    line-height: 1.5;
    letter-spacing: 0.06em;
    color: var(--accent-primary);
  }

  .eyebrow .sectors {
    color: var(--text-secondary);
    letter-spacing: normal;
  }

  .pending {
    position: relative;
    padding: var(--space-6);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.9375rem;
  }

  .pending-caret {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.25em;
    background: var(--accent-status);
    vertical-align: text-bottom;
    animation: pending-cursor-blink 1s steps(1) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .pending-caret {
      animation: none;
    }
  }

  @keyframes pending-cursor-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .disclaimer {
    margin: 0 0 var(--space-6);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-4);
  }

  .loading-more {
    margin: var(--space-6) 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }
</style>
