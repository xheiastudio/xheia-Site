---
// Header, intro line, list of CaseStudyCards, Footer (SPEC.md — Pages & routes /work).
// The first case study is featured with a bigger Display-font heading (Apple HIG
// design-improvement pass) - real visual hierarchy through typography, not box size;
// order is whatever getCollection returns, no editorial ranking implied beyond "shown
// first." Rebuilt from a multi-column card grid into a single-column editorial list
// ("pixelated but Apple" pass) - entries are separated by whitespace and a thin rule,
// not individual bordered boxes.
// Intro line (copy pass) leads with sector breadth instead of repeating Home's
// lifecycle phrasing verbatim — no new claims invented, ties into the sectors strip
// directly below it. A small static note sits below the real grid ("More engagements
// are added here as they wrap up.") — deliberately NOT typed/caret'd (Apple HIG
// design-improvement pass): a blinking cursor under three already-finished cards
// read as a stuck/broken loader, not an intentional "more coming" cue. The
// empty-state branch below is different - the section genuinely has nothing yet,
// so "in progress" is accurate - and (full redesign pass) now actually types out via
// TypedText with a persisting cursor, instead of static text with a merely
// decorative dash after it - the same typed-then-blinking convention Home/About/404
// already use, not a one-off.
//
// Handles two states so real case studies can be dropped into
// src/content/case-studies/ later with no further code changes: empty (now — an honest
// in-progress message, no fabricated content) and populated (an anonymization
// disclaimer above the grid, since entries name sector/scope, never clients).
//
// Renamed from "Track Record" (see SPEC.md revision note) — the compass_artifact
// research doc flags that label as priming a resume reading for a services buyer.
// Sectors strip is derived from each case study's tags (sector is always the last
// tag by convention — see src/content/case-studies/*.md) rather than hardcoded, so
// it stays in sync automatically as entries are added or removed.
import { getCollection } from 'astro:content';
import { caseStudySlug } from '../../content.config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import PageIntroAtmosphere from '../../components/PageIntroAtmosphere.astro';
import Footer from '../../components/Footer.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import TypedText from '../../components/TypedText.astro';

const caseStudies = await getCollection('caseStudies');

const sectors = [...new Set(caseStudies.map((cs) => cs.data.tags.at(-1)))].map(
  (sector) => sector!.replace(/^./, (c) => c.toUpperCase()),
);
---

<BaseLayout title="Work" description="Full-lifecycle data work, delivered.">
  <Header />
  <main id="main-content">
    <PageIntroAtmosphere>
      <h1 class="intro">
        Real engagements across life sciences, public sector, and fitness - different
        sectors, same underlying problem to solve.
      </h1>
    </PageIntroAtmosphere>
    <div class="work-page">
      {
        sectors.length > 0 && (
          <h2 class="eyebrow">
            // sectors <span class="sectors">{sectors.join(' · ')}</span>
          </h2>
        )
      }
      {
        caseStudies.length === 0 ? (
          <div class="pending">
            <TypedText
              as="p"
              text="Case studies are added here as real engagements are finalized for publication."
              keepCursor
            />
          </div>
        ) : (
          <>
            <p class="disclaimer">
              Client details are withheld by agreement; the work and outcomes below are
              real.
            </p>
            <div class="entries">
              {caseStudies.map(({ id, data }, i) => (
                <CaseStudyCard slug={caseStudySlug(id)} featured={i === 0} {...data} />
              ))}
            </div>
            <p class="loading-more">More engagements are added here as they wrap up.</p>
          </>
        )
      }
    </div>
  </main>
  <ContactCTA />
  <Footer />
</BaseLayout>

<style>
  /* Only the content BELOW the intro is width-constrained - the intro itself
     (PageIntroAtmosphere) is full-bleed, matching Home's actual structure and
     the same fix already applied to /approach: <main> here carries no width
     constraint, so the glow/mark reach the real viewport edges instead of
     being boxed inside this column. */
  .work-page {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-16);
  }

  /* Exact match to Home's headline (.headline, Hero.astro) - same font, weight,
     clamp, line-height, letter-spacing, same fix already proven on /approach.
     This was previously styled as a plain body paragraph (font-body, text-
     secondary, weight 400) - not a heading at all. */
  .intro {
    max-width: 46rem;
    margin: 0;
    color: var(--text);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(2.25rem, 3.4vw + 1.1rem, 3.75rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  /* --accent-primary-text, not --accent-primary: full-audit finding already
     fixed sitewide - raw --accent-primary as text is 4.22:1 against Ink in
     dark mode, below the 4.5:1 minimum. Size bumped 12px -> 13px, the same
     translated-minimum fix already applied everywhere else. */
  .eyebrow {
    margin: 0 0 var(--space-6);
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.8125rem;
    line-height: 1.5;
    letter-spacing: 0.06em;
    color: var(--accent-primary-text);
  }

  .eyebrow .sectors {
    color: var(--text-secondary);
    letter-spacing: normal;
  }

  /* TypedText's own <p class="type-target"> inherits color/font-family/font-size
     from this wrapper - no need to reach into the component with :global(). */
  .pending {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.9375rem;
  }

  .disclaimer {
    margin: 0 0 var(--space-6);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .entries {
    max-width: 42rem;
  }

  .loading-more {
    margin: var(--space-6) 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }
</style>
