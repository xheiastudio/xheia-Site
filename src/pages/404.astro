---
// Astro's static-build convention: this file becomes dist/404.html, served
// automatically by Netlify on any unmatched route - no redirect config needed.
// Didn't exist before this pass (Apple HIG design-improvement pass) - every other
// wrong-turn moment on the web gets a generic host page; this one gets the same
// terminal register as the rest of the site (mono type, $/> prompt glyphs, a
// staggered typed reveal via src/components/TypedText.astro), not Hero.astro's own
// exclusive bezel/scanlines/caret.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TypedText from '../components/TypedText.astro';
---

<BaseLayout title="Page not found" description="That page doesn't exist.">
  <Header />
  <main class="not-found" id="main-content">
    <p class="prompt-line">
      <span class="glyph" aria-hidden="true">$</span> locate --page <span id="not-found-path">this page</span>
    </p>
    <TypedText as="h1" text="404: no route matches that path." delay={0.3} />
    <TypedText as="p" text="Try the nav above, or head back home." delay={1.4} />
    <a class="home-link" href="/">&gt; cd /</a>
  </main>
  <Footer />
</BaseLayout>

<script>
  // This file is a static, pre-built HTML page (dist/404.html) served by the host
  // for any unmatched route — Astro.url.pathname at build time is fixed to /404,
  // not whatever path the visitor actually typed. window.location.pathname, read
  // here at runtime, reflects the real address bar URL instead.
  document.addEventListener('astro:page-load', () => {
    const el = document.getElementById('not-found-path');
    if (el) el.textContent = window.location.pathname;
  });
</script>

<style>
  .not-found {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-16) var(--space-4);
  }

  .prompt-line {
    margin: 0 0 var(--space-6);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  /* --accent-primary-text, not --accent-primary: same full-audit finding
     fixed sitewide - raw --accent-primary as text is 4.22:1 against Ink in
     dark mode, below the 4.5:1 minimum. */
  .glyph {
    color: var(--accent-primary-text);
  }

  /* font-mono, not font-display: same fix as every other page's real-text
     titles - Home's headline is 100% IBM Plex Mono. */
  .not-found :global(h1) {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.5;
  }

  .not-found :global(p) {
    margin: 0 0 var(--space-8);
    color: var(--text-secondary);
    font-size: 1.0625rem;
  }

  /* Full-review finding: the one link on the site with zero hover/focus
     treatment - every other link already gets a color shift + drawn-in
     underline + focus outline (Capabilities.astro's ".see-more" is the
     reference pattern). */
  .home-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--accent-primary-text);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    border-radius: var(--radius);
    transition: text-decoration-color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .home-link:hover,
  .home-link:focus-visible {
    text-decoration-color: currentColor;
  }

  .home-link:focus-visible {
    outline: 2px solid var(--accent-primary-text);
    outline-offset: 0.2em;
  }
</style>
</style>
