---
// Header, full origin narrative, ContactCTA, Footer (SPEC.md — Pages & routes /about).
// Narrative rewritten in the real-content pass from xheia-content-worksheet.md — drops
// the earlier biomedical-science framing entirely (confirmed by the operator as not
// fitting: "the biomed story just doesn't fit at all") in favor of the real hook: years
// of UK contracting across varied industries. Kept deliberately service-first per that
// pass's decision — day-to-day project detail lives only in Work's case studies, not
// here. Name resolved to Hoda (first name only, no surname, by choice). Headshot is
// still a placeholder — see .headshot-placeholder below.
//
// One headline-result paragraph added per the compass_artifact research doc (About had
// zero concrete proof in it) — wording traces exactly to
// src/content/case-studies/life-sciences-customer-intelligence.md, no new specifics.
// This is one sentence of proof, not a rundown — the other two case studies stay
// exclusive to /work.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';
import PixelRivets from '../components/PixelRivets.astro';
---

<BaseLayout
  title="About — Hoda"
  description="I'm Hoda — a full-stack data consultant who's spent four-plus years contracting across the UK."
>
  <Header />
  <main class="about-page">
    <div class="intro-row">
      <div class="headshot-placeholder" aria-hidden="true">
        <PixelRivets inset="0.25rem" />
        <span>[photo pending]</span>
      </div>
      <div class="intro-text">
        <h1>Hoda</h1>
        <p class="role">I do full-stack data consulting under the name Xheia.</p>
        <p class="location">Based remotely — working with clients across the UK and internationally.</p>
      </div>
    </div>

    <p>
      I've spent four-plus years contracting across the UK — moving between
      industries, systems, and problems rather than staying inside one company or one
      specialism.
    </p>
    <p>
      That range is the point: life sciences, public sector, and fitness
      organisations have all needed the same underlying thing — data cleaned,
      consolidated, and turned into something a team can actually act on.
    </p>
    <p>
      Most recently, that meant building a post-acquisition customer intelligence
      pipeline spanning three acquisitions for a life sciences client, delivered as a
      six-tab Power BI dashboard. <a href="/work">More case studies →</a>
    </p>
    <p>
      That work is now extending into agentic AI systems — the newest expression of
      the same full-lifecycle discipline, not a separate offering.
    </p>
  </main>
  <ContactCTA />
  <Footer />
</BaseLayout>

<style>
  .about-page {
    max-width: 40rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-16);
  }

  .intro-row {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .headshot-placeholder {
    position: relative;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 7rem;
    height: 7rem;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--text) 3%, transparent);
    text-align: center;
  }

  .headshot-placeholder span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-secondary);
  }

  .intro-text h1 {
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.7;
    margin-bottom: var(--space-3);
  }

  .role {
    margin: 0 0 var(--space-1);
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }

  .location {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.8125rem;
  }

  .about-page p {
    color: var(--text-secondary);
    font-size: 1.0625rem;
  }

  @media (max-width: 30rem) {
    .intro-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
