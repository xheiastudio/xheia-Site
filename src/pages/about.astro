---
// Header, full origin narrative, ContactCTA, Footer (SPEC.md — Pages & routes /about).
// Narrative is BRANDFINAL §1's Origin story, voiced in first person — this is the "small
// space" for the personal story the user approved in round-1 feedback, not a rewrite of
// the facts. Name and headshot are placeholders — see [Your Name] / .headshot-placeholder
// below — swap in real values once supplied; don't invent them.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';
import PixelRivets from '../components/PixelRivets.astro';
---

<BaseLayout
  title="About — [Your Name]"
  description="I'm [Your Name] — I have a biomedical science background, not the usual data path."
>
  <Header />
  <main class="about-page">
    <div class="intro-row">
      <div class="headshot-placeholder" aria-hidden="true">
        <PixelRivets inset="0.25rem" />
        <span>[photo pending]</span>
      </div>
      <div class="intro-text">
        <h1>[Your Name]</h1>
        <p class="role">I do full-stack data consulting under the name Xheia.</p>
      </div>
    </div>

    <p>
      I have a biomedical science background — not the usual data or computer science
      path. Moving into data work wasn't a planned trajectory for me; it was an
      unexpected, self-directed shift.
    </p>
    <p>
      Four-plus years since, I've delivered enterprise-scale data consolidation,
      predictive customer intelligence, financial modelling, and BI — across life
      sciences, public sector, retail, education, and fitness.
    </p>
    <p>
      That work is now extending into agentic AI systems, most recently an agentic
      customer profiling build I delivered. The AI is downstream of the data-quality
      work — not a separate offering, and not the headline.
    </p>
  </main>
  <ContactCTA />
  <Footer />
</BaseLayout>

<style>
  .about-page {
    max-width: 40rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-16);
  }

  .intro-row {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .headshot-placeholder {
    position: relative;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 7rem;
    height: 7rem;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--text) 3%, transparent);
    text-align: center;
  }

  .headshot-placeholder span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-secondary);
  }

  .intro-text h1 {
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.7;
    margin-bottom: var(--space-3);
  }

  .role {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }

  .about-page p {
    color: var(--text-secondary);
    font-size: 1.0625rem;
  }

  @media (max-width: 30rem) {
    .intro-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
