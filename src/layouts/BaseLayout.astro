---
// See SPEC.md — Design tokens, Theme toggle (FOUC prevention)
import { ClientRouter } from 'astro:transitions';
import PixelCursor from '../components/PixelCursor.astro';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/press-start-2p/400.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

// Default description is meta-only (not visible on-page) — safe to name the person here
// per the identity/discoverability pass without touching Home's visible, Xheia-forward copy.
const {
  title,
  description = 'Xheia is a full-stack data consultancy run by Hoda. I turn fragmented data into systems you can actually trust.',
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Xheia</title>
    <ClientRouter />
    <script is:inline>
      (function () {
        function resolveTheme() {
          var stored = localStorage.getItem('xheia-theme');
          return stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        }
        // Runs once, synchronously, before first paint - prevents a flash of the
        // wrong theme on a hard load. This alone isn't enough on its own: with
        // <ClientRouter /> enabled, Astro doesn't re-execute an inline script that's
        // byte-identical to one already run (by design, to avoid re-firing scripts
        // like analytics snippets on every soft navigation) - so this block never
        // ran again after the first page, and a soft navigation's incoming document
        // has no data-theme attribute of its own (it's only ever set by this script,
        // never server-rendered), silently resetting every subsequent page to dark
        // regardless of what the visitor had chosen. astro:before-swap fires before
        // each swap and exposes the incoming document directly - copying the
        // CURRENT theme onto it there re-applies the choice on every navigation,
        // with no flash, and needs no re-execution guard since it's a document-level
        // listener (document itself persists across soft navigations, only parts of
        // its content are swapped).
        document.documentElement.setAttribute('data-theme', resolveTheme());
        document.addEventListener('astro:before-swap', (e) => {
          e.newDocument.documentElement.setAttribute('data-theme', resolveTheme());
        });
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="boot-flicker" aria-hidden="true"></div>
    <PixelCursor />
    <slot />
    <script>
      // Reveal-on-scroll for [data-reveal] sections, and (elsewhere) ThemeToggle's click
      // handler, both wrapped in astro:page-load rather than run at top-level: with
      // <ClientRouter /> enabled, navigation swaps <body> content without a hard reload,
      // so anything that needs to (re)initialize per page — including the very first
      // load — must listen for this event rather than assume a one-time script run.
      document.addEventListener('astro:page-load', () => {
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.15 },
          );
          document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
        } else {
          document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-visible'));
        }
      });
    </script>
  </body>
</html>

<style>
  /* Standard keyboard-navigation affordance: off-screen until focused, then jumps
     on-screen above everything else so a keyboard user can bypass the header/nav
     on every page. Targets id="main-content" on each page's own <main>. */
  /* Border stays --accent-primary (non-text, 3:1 already passes); the text
     color switches to --accent-primary-text - same full-audit finding fixed
     sitewide, raw --accent-primary as text is 4.22:1 against Ink in dark
     mode, below the 4.5:1 minimum. */
  .skip-link {
    position: absolute;
    top: 0;
    left: -999px;
    z-index: 10000;
    padding: var(--space-2) var(--space-4);
    background: var(--bg);
    border: 1px solid var(--accent-primary);
    color: var(--accent-primary-text);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .skip-link:focus {
    left: var(--space-4);
    top: var(--space-4);
  }
</style>
